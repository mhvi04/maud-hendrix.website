---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StickyFooterBar from "../../components/StickyFooterBar.astro";
import { getCollection, render } from "astro:content";
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const publishedDate = entry.data.date.startsWith("[") ? undefined : entry.data.date;

const faqJsonLd =
  entry.data.faq && entry.data.faq.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: entry.data.faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }
    : null;

// Per-artikel og:image, indien aanwezig in public/og/<slug>.png — anders valt
// BaseLayout terug op de sitewide og-default.png.
const ownOgImagePath = fileURLToPath(new URL(`../../../public/og/${entry.id}.png`, import.meta.url));
const ogImage = existsSync(ownOgImagePath) ? `/og/${entry.id}.png` : undefined;
---

<BaseLayout
  title={`${entry.data.title} — Maud Hendrix`}
  description={entry.data.excerpt}
  type="article"
  publishedDate={publishedDate}
  noindex={entry.data.draft}
  image={ogImage}
>
  {faqJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
  )}
  <SiteHeader world="pro" />
  <main class="article">
    <div class="wrap">
      <a href="/artikelen" class="back mono">← Alle artikelen</a>
      <span class="tag mono">{entry.data.tag}</span>
      <h1>{entry.data.title}</h1>
      <p class="date mono">{entry.data.date}</p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </main>
  <StickyFooterBar showVat />
</BaseLayout>

<style>
  .article {
    background: var(--cream);
    padding-block: clamp(40px, 6vw, 72px) clamp(56px, 8vw, 96px);
  }
  .wrap {
    max-width: 720px;
  }
  .back {
    display: inline-block;
    font-size: 13px;
    color: var(--navy);
    text-decoration: none;
    margin-bottom: 28px;
    opacity: 0.8;
  }
  .back:hover {
    opacity: 1;
  }
  .tag {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }
  h1 {
    font-size: clamp(30px, 4.5vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    margin-block: 14px 10px;
  }
  .date {
    font-size: 13px;
    color: var(--navy);
    opacity: 0.75;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }
  .prose {
    font-size: 17px;
    line-height: 1.75;
  }
  .prose :global(h2) {
    font-size: 24px;
    font-weight: 600;
    margin-block: 44px 14px;
    padding-top: 28px;
    border-top: 2px solid var(--ink);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .prose :global(h3) {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mustard-deep);
    font-weight: 600;
    margin-block: 28px 10px;
  }
  .prose :global(p) {
    margin-bottom: 18px;
  }
  .prose > :global(p:first-child) {
    font-family: var(--font-display);
    font-size: 21px;
    line-height: 1.6;
  }
  .prose :global(strong) {
    color: var(--navy);
    font-weight: 700;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 4px 0 24px;
    padding-left: 0;
    list-style-position: inside;
  }
  .prose :global(ul li)::marker,
  .prose :global(ol li)::marker {
    content: "";
  }
  .prose :global(ul li),
  .prose :global(ol li) {
    position: relative;
    padding-left: 30px;
    margin-bottom: 12px;
  }
  .prose :global(ul li)::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 10px;
    width: 8px;
    height: 8px;
    background: var(--mustard);
  }
  .prose :global(ol) {
    counter-reset: step;
  }
  .prose :global(ol li)::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--cream);
    background: var(--navy);
    width: 20px;
    height: 20px;
    line-height: 20px;
    text-align: center;
  }
  .prose :global(blockquote) {
    margin: 36px 0;
    padding: 6px 0 6px 22px;
    border-left: 3px solid var(--mustard);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
  }
  .prose :global(blockquote p) {
    margin-bottom: 0;
  }
  .prose :global(hr) {
    border: none;
    border-top: 2px solid var(--ink);
    opacity: 0.15;
    margin: 40px 0;
  }
  .prose :global(a) {
    color: var(--navy);
    text-decoration-color: var(--mustard);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 3px solid var(--ink);
    padding: 12px 16px;
    text-align: left;
  }
  .prose :global(th) {
    background: var(--navy);
    color: var(--cream);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 12px;
  }
  .prose :global(td) {
    background: var(--paper);
  }
  .prose :global(.shape-divider) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 40px 0;
  }
  .prose :global(.shape-divider .shape) {
    display: block;
  }
  .prose :global(.shape-divider .shape--square) {
    width: 16px;
    height: 16px;
    background: var(--mustard);
  }
  .prose :global(.shape-divider .shape--circle) {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--navy);
  }
  .prose :global(.shape-divider .shape--triangle) {
    width: 0;
    height: 0;
    border-left: 9px solid transparent;
    border-right: 9px solid transparent;
    border-bottom: 16px solid var(--rust);
  }
</style>
