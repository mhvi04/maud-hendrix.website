---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StickyFooterBar from "../../components/StickyFooterBar.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const publishedDate = entry.data.date.startsWith("[") ? undefined : entry.data.date;
const ogImage = entry.id === "482-euro-vinted-boosts-5-lessen" ? "/og/482-euro-vinted-boosts-5-lessen.png" : undefined;
---

<BaseLayout
  title={`${entry.data.title} — Maud Hendrix`}
  description={entry.data.excerpt}
  type="article"
  publishedDate={publishedDate}
  noindex={entry.data.draft}
  image={ogImage}
>
  <SiteHeader world="pro" />
  <main class="article">
    <div class="wrap">
      <a href="/artikelen" class="back mono">← Alle artikelen</a>
      <span class="tag mono">{entry.data.tag}</span>
      <h1>{entry.data.title}</h1>
      <p class="date mono">{entry.data.date}</p>
      <div class="prose">
        <Content />
      </div>
    </div>
  </main>
  <StickyFooterBar showVat />
</BaseLayout>

<style>
  .article {
    background: var(--cream);
    padding-block: clamp(40px, 6vw, 72px) clamp(56px, 8vw, 96px);
  }
  .wrap {
    max-width: 720px;
  }
  .back {
    display: inline-block;
    font-size: 13px;
    color: var(--navy);
    text-decoration: none;
    margin-bottom: 28px;
    opacity: 0.8;
  }
  .back:hover {
    opacity: 1;
  }
  .tag {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }
  h1 {
    font-size: clamp(30px, 4.5vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    margin-block: 14px 10px;
  }
  .date {
    font-size: 13px;
    color: var(--navy);
    opacity: 0.75;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 24px;
    margin-bottom: 32px;
  }
  .prose {
    font-size: 17px;
    line-height: 1.75;
  }
  .prose :global(h2) {
    font-size: 24px;
    font-weight: 600;
    margin-block: 36px 14px;
  }
  .prose :global(p) {
    margin-bottom: 18px;
  }
  .prose :global(blockquote) {
    margin: 32px 0;
    padding-left: 22px;
    border-left: 3px solid var(--mustard);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
  }
  .prose :global(a) {
    color: var(--navy);
    text-decoration-color: var(--mustard);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 3px solid var(--ink);
    padding: 12px 16px;
    text-align: left;
  }
  .prose :global(th) {
    background: var(--navy);
    color: var(--cream);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 12px;
  }
  .prose :global(td) {
    background: var(--paper);
  }
  .prose :global(.shape-divider) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 40px 0;
  }
  .prose :global(.shape-divider .shape) {
    display: block;
  }
  .prose :global(.shape-divider .shape--square) {
    width: 16px;
    height: 16px;
    background: var(--mustard);
  }
  .prose :global(.shape-divider .shape--circle) {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--navy);
  }
  .prose :global(.shape-divider .shape--triangle) {
    width: 0;
    height: 0;
    border-left: 9px solid transparent;
    border-right: 9px solid transparent;
    border-bottom: 16px solid var(--rust);
  }
</style>
