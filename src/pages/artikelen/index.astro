---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StickyFooterBar from "../../components/StickyFooterBar.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const FEATURED_SLUG = "boosten-op-vinted";

const articles = (await getCollection("articles")).sort((a, b) => {
  if (a.id === FEATURED_SLUG) return -1;
  if (b.id === FEATURED_SLUG) return 1;
  return a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout
  title="Artikelen — Maud Hendrix"
  description="Artikelen over reselling, Vinted en data-gedreven ondernemen, geschreven door Maud Hendrix."
>
  <SiteHeader world="pro" />
  <main class="listing">
    <section class="wrap head">
      <span class="label">Maud Hendrix</span>
      <h1>Artikelen</h1>
    </section>
    <section class="wrap grid">
      {
        articles.map((a) => (
          <ArticleCard
            href={`/artikelen/${a.id}`}
            tag={a.data.tag}
            title={a.data.title}
            excerpt={a.data.excerpt}
            date={a.data.date}
          />
        ))
      }
    </section>
  </main>
  <StickyFooterBar showVat />
</BaseLayout>

<style>
  .listing {
    background: var(--cream);
  }
  .head {
    padding-block: clamp(48px, 7vw, 84px) clamp(32px, 5vw, 48px);
    border-bottom: 3px solid var(--ink);
  }
  .head h1 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 600;
    margin-block: 14px 12px;
  }
  .head p {
    font-size: 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
    padding-block: clamp(32px, 5vw, 56px);
  }
</style>
