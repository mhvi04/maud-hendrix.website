---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StickyFooterBar from "../../components/StickyFooterBar.astro";
import Timeline from "../../components/Timeline.astro";
import SkillsMarquee from "../../components/SkillsMarquee.astro";
import ToolsPattern from "../../components/ToolsPattern.astro";
import { Image } from "astro:assets";
import vintedProfielOud from "../../assets/proof/vinted-profiel-oud.jpg";
---

<BaseLayout
  title="Professioneel — Maud Hendrix"
  description="Criminologie, ondernemerschap en projecten van Maud Hendrix."
  nlPath="/professioneel"
  enPath="/professional"
>
  <SiteHeader world="pro" nlPath="/professioneel" enPath="/professional" />

  <main class="pro">
    <!-- INTRO -->
    <section class="intro">
      <div class="wrap intro-grid">
        <span class="block-mark" aria-hidden="true"></span>
        <div class="intro-copy">
          <span class="label label--on-mustard">01 / Professioneel</span>
          <h1>Criminologie &amp; <em>ondernemerschap.</em></h1>
          <p class="lede">
            Ik woon in Gent en studeer Criminologische Wetenschappen aan de
            Universiteit Gent. Sinds februari 2025 ben ik student-zelfstandige.
          </p>
          <p class="lede">
            Verkopen doe ik al sinds ongeveer mijn veertiende. Het begon met
            vintage Tupperware. Daarna volgden sneakers via Restocks en
            tweedehands kleding.
          </p>
          <div class="intro-links">
            <a
              class="btn btn--solid"
              href="https://www.linkedin.com/in/maud-hendrix-522245374"
              target="_blank"
              rel="noopener">LinkedIn</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- VAARDIGHEDEN -->
    <section class="skills-section">
      <div class="wrap skills-head">
        <span class="row-label label">Vaardigheden</span>
      </div>
      <SkillsMarquee />
    </section>

    <!-- TOOLS -->
    <section class="row wrap">
      <span class="row-label label">Tools</span>
      <div class="row-body">
        <span class="subhead label">Software &amp; tools</span>
        <ToolsPattern />
      </div>
    </section>

    <!-- ERVARING -->
    <section class="row wrap">
      <span class="row-label label">Ervaring</span>
      <div class="row-body experience">
        <article class="exp">
          <div class="exp-head">
            <h2>Student-zelfstandige — tweedehands e-commerce</h2>
            <span class="exp-period mono">Februari 2025 — heden</span>
          </div>
          <p class="exp-context">
            Gent en omgeving. Officieel zelfstandige sinds februari 2025,
            actief in de handel sinds mijn veertiende.
          </p>
          <ul>
            <li>
              Meer dan 2.500 transacties, van sourcing en prijszetting tot
              kwaliteitscontrole, verkoop en logistiek — allemaal in eigen
              beheer.
            </li>
            <li>
              Eigen analysekader voor inkoopprijzen, marges, voorraadrotatie,
              categorieprestaties en seizoenseffecten stuurt elke inkoop- en
              prijsbeslissing.
            </li>
            <li>
              Authenticiteits- en kwaliteitscontrole op merkkleding, met Ralph
              Lauren als hoofdcategorie.
            </li>
          </ul>
        </article>
      </div>
    </section>

    <!-- PROJECTEN & EERBETOON -->
    <section class="dark-block">
      <div class="wrap">
        <div class="dark-head">
          <span class="label label--on-dark">Projecten &amp; ervaring</span>
          <h2>Leren door <em>te doen.</em></h2>
        </div>

        <!-- VOORGESCHIEDENIS -->
        <div class="row row--dark">
          <span class="row-label label label--on-dark">Voorgeschiedenis</span>
          <div class="row-body voorgeschiedenis-body">
            <p>
              Mijn reputatie bouwde ik op via
              <a
                class="inline-link inline-link--on-dark"
                href="https://www.vinted.be/member/38856549-maudhendrix"
                target="_blank"
                rel="noopener">@maud.hendrix</a
              >
              op Vinted, tot het account geblokkeerd werd. Studio Maud is het
              vervolg.
            </p>
            <div class="stats-box">
              <div class="stat">
                <span class="stat-number mono">1.881</span>
                <span class="stat-label">Verkopen</span>
              </div>
              <div class="stat">
                <span class="stat-number mono">5</span>
                <span class="stat-label">Sterren</span>
              </div>
              <div class="stat">
                <span class="stat-number mono">3.233</span>
                <span class="stat-label">Volgers</span>
              </div>
            </div>
            <div class="voorgeschiedenis-proof">
              <Image
                src={vintedProfielOud}
                alt="Screenshot van het geblokkeerde Vinted-profiel @maud.hendrix: 5 sterren, 1881 verkopen, Gent, 3233 volgers"
                loading="lazy"
                widths={[380, 600, 900]}
                sizes="(max-width: 680px) 90vw, 340px"
              />
            </div>
          </div>
        </div>

        <!-- ONDERNEMING -->
        <div class="row row--dark">
          <span class="row-label label label--on-dark">Onderneming</span>
          <div class="row-body projects">
            <a
              class="project"
              href="https://www.vinted.be/member/306398525-studiomaud"
              target="_blank"
              rel="noopener"
            >
              <span class="project-number mono">01</span>
              <h3>Studio Maud</h3>
              <p>
                Tweedehands kleding van Ralph Lauren en andere merken,
                aangevuld met allerlei vondsten. Ik verkoop via onder meer
                Vinted, 2dehands, Facebook Marketplace en Vestiaire
                Collective.
              </p>
              <span class="project-cta mono">Bekijk Studio Maud op Vinted →</span>
            </a>

            <div class="project project--closed">
              <span class="project-number mono">02</span>
              <h3>VintieBulk</h3>
              <span class="project-pill mono">Afgeronde ervaring</span>
              <p class="project-desc">
                Als medeoprichter werkte ik aan een B2B-aanbod van gecureerde
                partijen en resellerboxen met tweedehands Ralph Lauren.
                Anderen zetten het onder een andere naam voort.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRAJECT -->
    <section class="row wrap traject">
      <span class="row-label label">Traject</span>
      <div class="row-body">
        <Timeline />
      </div>
    </section>

    <!-- OPLEIDING & ACHTERGROND -->
    <section class="wrap opleiding">
      <span class="label">Opleiding &amp; achtergrond</span>
      <h2>Een basis om <em>op verder te bouwen.</em></h2>

      <hr class="rule" />
      <h3>Universiteit Gent</h3>
      <p>
        Bachelor Criminologische Wetenschappen. Gestart in 2021. Derde en
        laatste bachelorjaar vanaf september 2026.
      </p>

      <hr class="rule" />
      <h3>GO! Atheneum Voskenslaan Gent</h3>
      <p>Humane Wetenschappen, cum laude.</p>

      <hr class="rule" />
      <h3>Talen</h3>
      <ul class="lang-list">
        <li class="lang-row">
          <span class="lang-name">Nederlands</span>
          <span class="lang-level mono">C2 · moedertaal</span>
        </li>
        <li class="lang-row">
          <span class="lang-name">Engels</span>
          <span class="lang-level mono">B2</span>
        </li>
        <li class="lang-row">
          <span class="lang-name">Frans</span>
          <span class="lang-level mono">A2</span>
        </li>
      </ul>

      <hr class="rule" />
      <h3>Vrijwilligerswerk</h3>
      <p>Katten socialiseren bij Dierenasiel Gent.</p>
    </section>

    <!-- CONTACT -->
    <section class="contact">
      <div class="wrap contact-grid">
        <div>
          <span class="label">Contact</span>
          <h2>Laten we <em>praten</em>.</h2>
          <p>
            Open voor stages, studentenjobs en samenwerkingen rond
            reselling, e-commerce of data — en voor gesprekken die criminologie
            en handel samenbrengen.
          </p>
          <div class="contact-actions">
            <a class="btn btn--mustard" href="mailto:StudioMaud@outlook.com"
              >Mail sturen</a
            >
          </div>
        </div>
        <div class="contact-meta">
          <p class="mono"><span>Mail</span>StudioMaud@outlook.com</p>
          <p class="mono">
            <span>LinkedIn</span>
            <a href="https://www.linkedin.com/in/maud-hendrix-522245374" target="_blank" rel="noopener"
              >maud-hendrix-522245374</a
            >
          </p>
          <p class="mono"><span>Locatie</span>Gent, België</p>
        </div>
      </div>
    </section>
  </main>

  <StickyFooterBar showVat />
</BaseLayout>

<style>
  .pro {
    background: var(--cream);
  }

  /* INTRO */
  .intro {
    background: var(--mustard);
    border-bottom: 1px solid var(--ink);
    padding-block: clamp(48px, 7vw, 88px);
    position: relative;
  }
  .intro-grid {
    position: relative;
  }
  .block-mark {
    display: none;
  }
  .intro-copy {
    position: relative;
    z-index: 1;
    max-width: 62ch;
  }
  .intro-copy h1 {
    font-size: clamp(36px, 5.5vw, 60px);
    font-weight: 600;
    color: var(--ink);
    margin-block: 16px 20px;
    line-height: 1.05;
  }
  .lede {
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 28px;
  }
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* ROWS */
  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    padding-block: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--ink);
  }
  .row-label {
    padding-top: 4px;
  }
  .row-body {
    min-width: 0;
  }
  .row-body h2 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .row-body > p {
    font-size: 16px;
    line-height: 1.6;
    max-width: 60ch;
  }

  @media (max-width: 680px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  /* EDUCATION */
  .education {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .edu-period {
    display: block;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--mustard-deep);
    margin-bottom: 8px;
  }
  .edu p {
    font-size: 15px;
    opacity: 0.85;
  }

  /* SKILLS */
  .skills-section {
    border-bottom: 1px solid var(--ink);
    padding-block: clamp(36px, 5vw, 56px) 0;
  }
  .skills-head {
    padding-bottom: 20px;
  }

  /* LANGUAGES & TOOLS */
  .langs-tools {
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: 44px;
  }
  .langs,
  .tools {
    min-width: 0;
  }
  .subhead {
    display: flex;
    margin-bottom: 18px;
  }

  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .lang-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--ink);
  }
  .lang-name {
    font-size: 17px;
    font-weight: 600;
  }
  .lang-level {
    font-size: 13px;
    color: var(--navy);
    white-space: nowrap;
  }

  @media (max-width: 780px) {
    .langs-tools {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* EXPERIENCE */
  .experience {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .exp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: 14px;
  }
  .exp-head h2 {
    font-size: clamp(20px, 2.6vw, 26px);
  }
  .exp-period {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--navy);
    opacity: 0.8;
    white-space: nowrap;
  }
  .exp--closed .exp-period {
    color: var(--rust);
    opacity: 1;
  }
  .exp-context {
    font-size: 15px;
    line-height: 1.6;
    max-width: 62ch;
    margin-bottom: 16px;
  }
  .exp ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 68ch;
  }
  .exp li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.55;
  }
  .exp li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    background: var(--mustard);
  }
  .exp--closed li::before {
    background: var(--rust);
  }

  .inline-link {
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--navy);
  }
  .inline-link:hover {
    color: var(--rust);
    border-color: var(--rust);
  }
  .inline-link--on-dark {
    color: var(--mustard);
    border-bottom-color: var(--mustard);
  }
  .inline-link--on-dark:hover {
    color: var(--cream);
    border-color: var(--cream);
  }

  /* PROJECTEN & EERBETOON — marineblauw blok */
  .dark-block {
    background: var(--navy);
    padding-block: clamp(12px, 2vw, 20px);
  }
  .dark-head {
    padding-block: clamp(28px, 4vw, 40px) clamp(20px, 3vw, 32px);
  }
  .dark-head h2 {
    color: var(--cream);
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 800;
    margin-top: 14px;
    line-height: 1.1;
  }
  .row--dark {
    border-bottom: none;
  }
  .row--dark + .row--dark {
    border-top: 2px solid rgba(250, 246, 234, 0.2);
  }
  .row--dark .row-body > p,
  .row--dark .voorgeschiedenis-body p {
    color: var(--paper);
  }

  .voorgeschiedenis-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 28px;
  }
  .voorgeschiedenis-body p {
    flex: 1 1 320px;
  }
  .voorgeschiedenis-proof {
    flex: 0 1 340px;
    border: 1px solid var(--cream);
    background: var(--paper);
    padding: 10px;
    min-width: 0;
    align-self: flex-start;
  }
  .voorgeschiedenis-proof :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* STATISTIEKEN */
  .stats-box {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: clamp(24px, 4vw, 48px);
    border: 2px solid var(--mustard);
    padding: clamp(18px, 3vw, 28px) clamp(24px, 4vw, 40px);
    margin-block: 22px;
    width: fit-content;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stat-number {
    font-size: clamp(32px, 4.5vw, 46px);
    font-weight: 700;
    line-height: 1;
    color: var(--paper);
  }
  .stat-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mustard);
  }

  @media (max-width: 560px) {
    .stats-box {
      grid-template-columns: 1fr;
      width: 100%;
    }
  }

  /* PROJECTS */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--cream);
    background: var(--paper);
    padding: 26px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  a.project:hover {
    transform: translateY(-2px);
    box-shadow: none;
  }
  .project--closed {
    background: transparent;
    border-color: transparent;
    color: var(--paper);
    padding: 0;
    opacity: 0.9;
  }
  .project-number {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--navy);
    opacity: 0.55;
  }
  .project--closed .project-number {
    color: var(--mustard);
    opacity: 1;
  }
  .project-status {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }
  .project-pill {
    display: inline-block;
    width: fit-content;
    border: 1px solid rgba(250, 246, 234, 0.4);
    border-radius: 20px;
    padding: 6px 16px;
    font-size: 12px;
  }
  .project-status--closed {
    color: var(--periwinkle);
  }
  .project h3 {
    font-size: 21px;
    font-weight: 600;
  }
  .project--closed h3 {
    color: var(--paper);
  }
  .project p {
    font-size: 14px;
    line-height: 1.55;
  }
  .project-cta {
    margin-top: auto;
    font-size: 12px;
    padding-top: 8px;
    color: var(--navy);
  }
  .project-list {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .project-list li {
    position: relative;
    padding-left: 18px;
    font-size: 13px;
    line-height: 1.5;
  }
  .project-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 7px;
    width: 6px;
    height: 6px;
    background: var(--mustard);
  }

  /* OPLEIDING & ACHTERGROND */
  .opleiding {
    padding-block: clamp(48px, 7vw, 80px);
    border-bottom: 1px solid var(--ink);
  }
  .opleiding h2 {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 800;
    margin-block: 14px 8px;
    line-height: 1.1;
  }
  .opleiding h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .opleiding > .rule {
    margin-block: 28px;
  }
  .opleiding .lang-list {
    border-top: none;
    margin-top: 4px;
  }

  /* CONTACT */
  .contact {
    background: var(--cream);
    color: var(--ink);
    border-top: 1px solid var(--ink);
    padding-block: clamp(48px, 7vw, 88px);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
  }
  .contact h2 {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 600;
    margin-block: 14px 16px;
  }
  .contact p {
    font-size: 16px;
    line-height: 1.6;
    max-width: 46ch;
    opacity: 0.85;
    margin-bottom: 26px;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .contact-meta {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
    border-left: 2px solid rgba(26, 22, 15, 0.2);
    padding-left: 32px;
  }
  .contact-meta p {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    margin: 0;
  }
  .contact-meta span {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }
  .contact-meta a {
    text-decoration: none;
    border-bottom: 1px solid rgba(26, 22, 15, 0.4);
    width: fit-content;
  }

  @media (max-width: 680px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-meta {
      border-left: none;
      padding-left: 0;
      border-top: 2px solid rgba(26, 22, 15, 0.2);
      padding-top: 24px;
    }
  }
</style>
