---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StickyFooterBar from "../../components/StickyFooterBar.astro";
import Timeline from "../../components/Timeline.astro";
import SkillsMarquee from "../../components/SkillsMarquee.astro";
import ToolsPattern from "../../components/ToolsPattern.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { Image } from "astro:assets";
import vintedProfielOud from "../../assets/proof/vinted-profiel-oud.jpg";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<BaseLayout
  title="Professioneel — Maud Hendrix"
  description="Criminologie, ondernemerschap, projecten en artikelen van Maud Hendrix."
>
  <SiteHeader world="pro" />

  <main class="pro">
    <!-- INTRO -->
    <section class="intro">
      <div class="wrap intro-grid">
        <span class="block-mark" aria-hidden="true"></span>
        <div class="intro-copy">
          <span class="label">Profiel</span>
          <h1>Ik ben Maud Hendrix</h1>
          <p class="lede">
            Ik ben student Criminologische Wetenschappen aan de UGent en
            student-zelfstandige in tweedehands e-commerce. Criminologie leert
            me gedrag en systemen analyseren. In mijn onderneming pas ik die
           zelfde manier van denken dagelijks toe op data, prijszetting,
            koopgedrag en operationele beslissingen. Zo combineer ik mijn
            academische opleiding met praktijkervaring uit meer dan 2.500
            transacties.
          </p>
          <div class="intro-links">
            <a
              class="btn btn--solid"
              href="https://www.linkedin.com/in/maud-hendrix-522245374"
              target="_blank"
              rel="noopener">LinkedIn</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- STUDIE -->
    <section class="row wrap">
      <span class="row-label label">Studie</span>
      <div class="row-body education">
        <div class="edu">
          <span class="edu-period mono">2021 — verwacht 2026</span>
          <h2>Bachelor Criminologische Wetenschappen — UGent</h2>
        </div>
        <div class="edu">
          <span class="edu-period mono">Afgestudeerd 2022</span>
          <h2>Humane Wetenschappen — GO! Atheneum Voskenslaan, Gent</h2>
          <p>Afgestudeerd met cum laude.</p>
        </div>
      </div>
    </section>

    <!-- VAARDIGHEDEN -->
    <section class="skills-section">
      <div class="wrap skills-head">
        <span class="row-label label">Vaardigheden</span>
      </div>
      <SkillsMarquee />
    </section>

    <!-- TALEN & TOOLS -->
    <section class="row wrap">
      <span class="row-label label">Talen & Tools</span>
      <div class="row-body langs-tools">
        <div class="langs">
          <span class="subhead label">Talen</span>
          <ul class="lang-list">
            <li class="lang-row">
              <span class="lang-name">Nederlands</span>
              <span class="lang-level mono">C2 · moedertaal</span>
            </li>
            <li class="lang-row">
              <span class="lang-name">Engels</span>
              <span class="lang-level mono">B2</span>
            </li>
            <li class="lang-row">
              <span class="lang-name">Frans</span>
              <span class="lang-level mono">A2</span>
            </li>
          </ul>
        </div>
        <div class="tools">
          <span class="subhead label">Software &amp; tools</span>
          <ToolsPattern />
        </div>
      </div>
    </section>

    <!-- ERVARING -->
    <section class="row wrap">
      <span class="row-label label">Ervaring</span>
      <div class="row-body experience">
        <article class="exp">
          <div class="exp-head">
            <h2>Student-zelfstandige — tweedehands e-commerce</h2>
            <span class="exp-period mono">Februari 2025 — heden</span>
          </div>
          <p class="exp-context">
            Gent en omgeving. Officieel zelfstandige sinds februari 2025,
            actief in de handel sinds mijn veertiende.
          </p>
          <ul>
            <li>
              Meer dan 2.500 transacties, van sourcing en prijszetting tot
              kwaliteitscontrole, verkoop en logistiek — allemaal in eigen
              beheer.
            </li>
            <li>
              Eigen analysekader voor inkoopprijzen, marges, voorraadrotatie,
              categorieprestaties en seizoenseffecten stuurt elke inkoop- en
              prijsbeslissing.
            </li>
            <li>
              Authenticiteits- en kwaliteitscontrole op merkkleding, met Ralph
              Lauren als hoofdcategorie.
            </li>
          </ul>
        </article>

        <article class="exp exp--closed">
          <div class="exp-head">
            <h2>Mede-oprichter — VintieBulk</h2>
            <span class="exp-period mono">Afgerond</span>
          </div>
          <p class="exp-context">
            B2B-aanbod van gecureerde partijen en resellerboxen met
            tweedehands Ralph Lauren.
          </p>
          <ul>
            <li>
              Bouwde het aanbod op eigen transactiedata en verkoopervaring:
              gecureerde partijen samengesteld op wat effectief verkoopt.
            </li>
            <li>Bouwde de webshop, branding, content en klantencommunicatie op.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- VOORGESCHIEDENIS -->
    <section class="row wrap">
      <span class="row-label label">Voorgeschiedenis</span>
      <div class="row-body voorgeschiedenis-body">
        <p>
          Mijn reputatie bouwde ik op via
          <a
            class="inline-link"
            href="https://www.vinted.be/member/38856549-maudhendrix"
            target="_blank"
            rel="noopener">@maud.hendrix</a
          >
          op Vinted: <span class="mono">1881</span> verkopen,
          <span class="mono">5</span> sterren, <span class="mono">3233</span>
          volgers, tot het account geblokkeerd werd. Studio Maud is het
          vervolg.
        </p>
        <div class="voorgeschiedenis-proof">
          <Image
            src={vintedProfielOud}
            alt="Screenshot van het geblokkeerde Vinted-profiel @maud.hendrix: 5 sterren, 1881 verkopen, Gent, 3233 volgers"
            loading="lazy"
            widths={[380, 600, 900]}
            sizes="(max-width: 680px) 90vw, 340px"
          />
        </div>
      </div>
    </section>

    <!-- ONDERNEMING -->
    <section class="row wrap">
      <span class="row-label label">Onderneming</span>
      <div class="row-body projects">
        <a
          class="project"
          href="https://www.vinted.be/member/306398525-studiomaud"
          target="_blank"
          rel="noopener"
        >
          <span class="project-status mono">Actief</span>
          <h3>Studio Maud</h3>
          <p>
            Data-gedreven tweedehands e-commerce op Vinted: 2.500+ transacties,
            774 orders in 2025 aan 56% brutomarge, verkopersbeoordeling
            4,81/5. Sourcing, prijszetting, kwaliteitscontrole en logistiek
            allemaal in eigen beheer.
          </p>
          <span class="project-cta mono">Bekijk profiel →</span>
        </a>
      </div>
    </section>

    <!-- TRAJECT -->
    <section class="row wrap traject">
      <span class="row-label label">Traject</span>
      <div class="row-body">
        <Timeline />
      </div>
    </section>

    <!-- ARTIKELEN -->
    <section class="row wrap">
      <span class="row-label label">Artikelen</span>
      <div class="row-body">
        <div class="article-grid">
          {
            articles.map((a) => (
              <ArticleCard
                href={`/artikelen/${a.id}`}
                tag={a.data.tag}
                title={a.data.title}
                excerpt={a.data.excerpt}
                date={a.data.date}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact">
      <div class="wrap contact-grid">
        <div>
          <span class="label label--on-dark">Contact</span>
          <h2>Laten we praten.</h2>
          <p>
            Open voor stages, studentenjobs en samenwerkingen rond
            reselling, e-commerce of data — en voor gesprekken die criminologie
            en handel samenbrengen.
          </p>
          <div class="contact-actions">
            <a class="btn btn--mustard" href="mailto:StudioMaud@outlook.com"
              >Mail sturen</a
            >
          </div>
        </div>
        <div class="contact-meta">
          <p class="mono"><span>Mail</span>StudioMaud@outlook.com</p>
          <p class="mono">
            <span>LinkedIn</span>
            <a href="https://www.linkedin.com/in/maud-hendrix-522245374" target="_blank" rel="noopener"
              >maud-hendrix-522245374</a
            >
          </p>
          <p class="mono"><span>Locatie</span>Gent, België</p>
        </div>
      </div>
    </section>
  </main>

  <StickyFooterBar showVat />
</BaseLayout>

<style>
  .pro {
    background: var(--cream);
  }

  /* INTRO */
  .intro {
    border-bottom: 3px solid var(--ink);
    padding-block: clamp(48px, 7vw, 88px);
    position: relative;
  }
  .intro-grid {
    position: relative;
  }
  .block-mark {
    position: absolute;
    top: -12px;
    right: 8%;
    width: 90px;
    height: 90px;
    background: var(--mustard);
    z-index: 0;
  }
  .intro-copy {
    position: relative;
    z-index: 1;
    max-width: 62ch;
  }
  .intro-copy h1 {
    font-size: clamp(36px, 5.5vw, 60px);
    font-weight: 600;
    margin-block: 16px 20px;
    line-height: 1.05;
  }
  .lede {
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 28px;
  }
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* ROWS */
  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    padding-block: clamp(36px, 5vw, 56px);
    border-bottom: 2px solid var(--ink);
  }
  .row-label {
    padding-top: 4px;
  }
  .row-body {
    min-width: 0;
  }
  .row-body h2 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .row-body > p {
    font-size: 16px;
    line-height: 1.6;
    max-width: 60ch;
  }

  @media (max-width: 680px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  /* EDUCATION */
  .education {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .edu-period {
    display: block;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--mustard-deep);
    margin-bottom: 8px;
  }
  .edu p {
    font-size: 15px;
    opacity: 0.85;
  }

  /* SKILLS */
  .skills-section {
    border-bottom: 2px solid var(--ink);
    padding-block: clamp(36px, 5vw, 56px) 0;
  }
  .skills-head {
    padding-bottom: 20px;
  }

  /* LANGUAGES & TOOLS */
  .langs-tools {
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: 44px;
  }
  .langs,
  .tools {
    min-width: 0;
  }
  .subhead {
    display: flex;
    margin-bottom: 18px;
  }

  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .lang-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 2px solid var(--ink);
  }
  .lang-name {
    font-size: 17px;
    font-weight: 600;
  }
  .lang-level {
    font-size: 13px;
    color: var(--navy);
    white-space: nowrap;
  }

  @media (max-width: 780px) {
    .langs-tools {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* EXPERIENCE */
  .experience {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .exp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 20px;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: 14px;
  }
  .exp-head h2 {
    font-size: clamp(20px, 2.6vw, 26px);
  }
  .exp-period {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--navy);
    opacity: 0.8;
    white-space: nowrap;
  }
  .exp--closed .exp-period {
    color: var(--rust);
    opacity: 1;
  }
  .exp-context {
    font-size: 15px;
    line-height: 1.6;
    max-width: 62ch;
    margin-bottom: 16px;
  }
  .exp ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 68ch;
  }
  .exp li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.55;
  }
  .exp li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    background: var(--mustard);
  }
  .exp--closed li::before {
    background: var(--rust);
  }

  .inline-link {
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--navy);
  }
  .inline-link:hover {
    color: var(--rust);
    border-color: var(--rust);
  }

  .voorgeschiedenis-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 28px;
  }
  .voorgeschiedenis-body p {
    flex: 1 1 320px;
  }
  .voorgeschiedenis-proof {
    flex: 0 1 340px;
    border: 3px solid var(--ink);
    background: var(--paper);
    padding: 10px;
    min-width: 0;
  }
  .voorgeschiedenis-proof :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* PROJECTS */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 3px solid var(--ink);
    background: var(--paper);
    padding: 26px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  a.project:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .project--closed {
    background: transparent;
    opacity: 0.85;
  }
  .project-status {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }
  .project h3 {
    font-size: 21px;
    font-weight: 600;
  }
  .project p {
    font-size: 14px;
    line-height: 1.55;
  }
  .project-cta {
    margin-top: auto;
    font-size: 12px;
    padding-top: 8px;
    color: var(--navy);
  }

  /* ARTICLES */
  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }

  /* CONTACT */
  .contact {
    background: var(--navy);
    color: var(--paper);
    padding-block: clamp(48px, 7vw, 88px);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
  }
  .contact h2 {
    color: var(--paper);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 600;
    margin-block: 14px 16px;
  }
  .contact p {
    font-size: 16px;
    line-height: 1.6;
    max-width: 46ch;
    opacity: 0.92;
    margin-bottom: 26px;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .contact .btn {
    border-color: var(--paper);
    color: var(--paper);
  }
  .contact .btn:hover {
    background: var(--paper);
    color: var(--navy);
  }
  .contact-meta {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
    border-left: 2px solid rgba(250, 246, 234, 0.35);
    padding-left: 32px;
  }
  .contact-meta p {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    margin: 0;
  }
  .contact-meta span {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard);
  }
  .contact-meta a {
    text-decoration: none;
    border-bottom: 1px solid rgba(250, 246, 234, 0.5);
    width: fit-content;
  }

  @media (max-width: 680px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-meta {
      border-left: none;
      padding-left: 0;
      border-top: 2px solid rgba(250, 246, 234, 0.35);
      padding-top: 24px;
    }
  }
</style>
