---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const gidsen = (await getCollection("resellerGidsen")).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
---

<BaseLayout
  title="Reseller Gidsen — Maud Hendrix"
  description="Reseller gidsen van VintieBulk: praktijkkennis over inkoop, boosten, onderhandelen en verkopen op Vinted, gebaseerd op meer dan 2.500 transacties."
>
  <SiteHeader world="pro" />
  <main class="listing">
    <section class="wrap head">
      <span class="label">VintieBulk</span>
      <h1>Reseller Gidsen</h1>
      <p>
        Praktijkgidsen voor Vinted resellers, oorspronkelijk gepubliceerd door
        VintieBulk en gebaseerd op meer dan 2.500 eigen verkooptransacties.
      </p>
    </section>
    <section class="wrap grid">
      {
        gidsen.map((g) => (
          <ArticleCard
            href={`/reseller-gidsen/${g.id}`}
            tag={g.data.tag}
            title={g.data.title}
            excerpt={g.data.excerpt}
            date={g.data.date}
          />
        ))
      }
    </section>
  </main>
  <SiteFooter world="pro" />
</BaseLayout>

<style>
  .listing {
    background: var(--cream);
  }
  .head {
    padding-block: clamp(48px, 7vw, 84px) clamp(32px, 5vw, 48px);
    border-bottom: 3px solid var(--ink);
  }
  .head h1 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 600;
    margin-block: 14px 12px;
  }
  .head p {
    font-size: 16px;
    max-width: 60ch;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
    padding-block: clamp(32px, 5vw, 56px);
  }
</style>
