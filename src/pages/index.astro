---
import BaseLayout from "../layouts/BaseLayout.astro";
import StickyFooterBar from "../components/StickyFooterBar.astro";
import Typewriter from "../components/Typewriter.astro";
import InteractiePaneel from "../components/InteractiePaneel.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
import Timeline from "../components/Timeline.astro";
import SkillsMarquee from "../components/SkillsMarquee.astro";
import ToolsPattern from "../components/ToolsPattern.astro";
import CountUp from "../components/CountUp.astro";
import Gelezen from "../components/Gelezen.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { Image } from "astro:assets";
import vintedProfielOud from "../assets/proof/vinted-profiel-oud.jpg";

import { getCollection } from "astro:content";

// Zelfde uitgelicht artikel als op /artikelen: altijd bovenaan.
const FEATURED_SLUG = "boosten-op-vinted";

const articles = (await getCollection("articlesNl", ({ data }) => !data.draft)).sort((a, b) => {
  if (a.id === FEATURED_SLUG) return -1;
  if (b.id === FEATURED_SLUG) return 1;
  return b.data.date.localeCompare(a.data.date) || a.data.title.localeCompare(b.data.title);
});

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("nl-BE", { day: "numeric", month: "short", year: "numeric" });

const socials = [
  {
    name: "Instagram",
    handle: "@hendrix.maud",
    href: "https://www.instagram.com/hendrix.maud",
  },
  {
    name: "LinkedIn",
    handle: "maud-hendrix-522245374",
    href: "https://www.linkedin.com/in/maud-hendrix-522245374",
  },
];

const interests = [
  { title: "Muurklimmen", desc: "Probleemoplossen, één beweging tegelijk." },
  { title: "Koken", desc: "Recepten als richtlijn, nooit als wet." },
  { title: "Fotografie", desc: "Details vastleggen die anders onopgemerkt blijven." },
];
---

<BaseLayout title="Maud Hendrix" nlPath="/" enPath="/">
  <main class="home">
    <InteractiePaneel />
    <LanguagePicker locale="nl" nlPath="/" enPath="/" />

    <nav class="site-nav" id="top">
      <div class="wrap nav-bar">
        <a href="#top" class="nav-mark">mh<span class="nav-dot">.</span></a>
        <div class="nav-links mono">
          <a href="#professioneel">Professioneel</a>
          <a href="#prive">Privé</a>
          <a href="/artikelen">Artikelen</a>
          <a href="#contact">Contact</a>
        </div>
      </div>
    </nav>

    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-meta">
          <span class="eyebrow-index mono">MH — GENT, BE</span>
        </div>

        <h1 class="hero-title" aria-label="Maud Hendrix">
          <Typewriter lines={["Maud", "Hendrix"]} minDelay={60} maxDelay={120} blinks={4} />
        </h1>

        <div class="hero-statement">
          <p>
            Criminologie leert me stilstaan bij waarom mensen doen wat ze
            doen. Mijn onderneming leert me dat in de praktijk brengen, dag na
            dag, cijfer na cijfer. Het is minder een masterplan dan een
            gewoonte die is blijven groeien.
          </p>
        </div>

        <div class="hero-cta">
          <a class="btn btn--solid" href="#professioneel">Professioneel ↓</a>
          <a class="btn" href="#prive">Privé ↓</a>
        </div>
      </div>
    </section>

    <!-- 01 PROFESSIONEEL -->
    <section class="world-section" id="professioneel">
      <div class="wrap world-intro">
        <span class="label">01 / Professioneel</span>
        <h2>Ik ben Maud Hendrix</h2>
        <p class="world-lede">
          Ik ben student Criminologische Wetenschappen aan de UGent en
          student-zelfstandige in tweedehands e-commerce. Criminologie leert
          me gedrag en systemen analyseren. In mijn onderneming pas ik die
          zelfde manier van denken dagelijks toe op data, prijszetting,
          koopgedrag en operationele beslissingen. Zo combineer ik mijn
          academische opleiding met praktijkervaring uit meer dan 2.500
          transacties.
        </p>
        <div class="world-links">
          <a
            class="btn btn--solid"
            href="https://www.linkedin.com/in/maud-hendrix-522245374"
            target="_blank"
            rel="noopener">LinkedIn</a
          >
          <a class="btn" href="/professioneel">Volledige pagina →</a>
        </div>
      </div>

      <div class="row wrap">
        <span class="row-label label">Studie</span>
        <div class="row-body education">
          <div class="edu">
            <span class="edu-period mono">2021 — verwacht 2026</span>
            <h3>Bachelor Criminologische Wetenschappen — UGent</h3>
          </div>
          <div class="edu">
            <span class="edu-period mono">Afgestudeerd 2022</span>
            <h3>Humane Wetenschappen — GO! Atheneum Voskenslaan, Gent</h3>
            <p>Afgestudeerd met cum laude.</p>
          </div>
        </div>
      </div>

      <div class="skills-section">
        <div class="wrap skills-head">
          <span class="row-label label">Vaardigheden</span>
        </div>
        <SkillsMarquee />
      </div>

      <div class="row wrap">
        <span class="row-label label">Talen & Tools</span>
        <div class="row-body langs-tools">
          <div class="langs">
            <span class="subhead label">Talen</span>
            <ul class="lang-list">
              <li class="lang-row">
                <span class="lang-name">Nederlands</span>
                <span class="lang-level mono">C2 · moedertaal</span>
              </li>
              <li class="lang-row">
                <span class="lang-name">Engels</span>
                <span class="lang-level mono">B2</span>
              </li>
              <li class="lang-row">
                <span class="lang-name">Frans</span>
                <span class="lang-level mono">A2</span>
              </li>
            </ul>
          </div>
          <div class="tools">
            <span class="subhead label">Software &amp; tools</span>
            <ToolsPattern />
          </div>
        </div>
      </div>

      <div class="row wrap">
        <span class="row-label label">Ervaring</span>
        <div class="row-body experience">
          <article class="exp">
            <div class="exp-head">
              <h3>Student-zelfstandige — tweedehands e-commerce</h3>
              <span class="exp-period mono">Februari 2025 — heden</span>
            </div>
            <p class="exp-context">
              Gent en omgeving. Officieel zelfstandige sinds februari 2025,
              actief in de handel sinds mijn veertiende.
            </p>
            <ul>
              <li>
                Meer dan 2.500 transacties, van sourcing en prijszetting tot
                kwaliteitscontrole, verkoop en logistiek — allemaal in eigen
                beheer.
              </li>
              <li>
                Eigen analysekader voor inkoopprijzen, marges, voorraadrotatie,
                categorieprestaties en seizoenseffecten stuurt elke inkoop- en
                prijsbeslissing.
              </li>
              <li>
                Authenticiteits- en kwaliteitscontrole op merkkleding, met Ralph
                Lauren als hoofdcategorie.
              </li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- PROJECTEN & EERBETOON -->
    <section class="dark-block">
      <div class="wrap">
        <div class="row row--dark">
          <span class="row-label label label--on-dark">Voorgeschiedenis</span>
          <div class="row-body voorgeschiedenis-body">
            <p>
              Mijn reputatie bouwde ik op via
              <a
                class="inline-link inline-link--on-dark"
                href="https://www.vinted.be/member/38856549-maudhendrix"
                target="_blank"
                rel="noopener">@maud.hendrix</a
              >
              op Vinted, tot het account geblokkeerd werd. Studio Maud is het
              vervolg.
            </p>
            <div class="stats-box">
              <div class="stat">
                <span class="stat-number mono">1.881</span>
                <span class="stat-label">Verkopen</span>
              </div>
              <div class="stat">
                <span class="stat-number mono">5</span>
                <span class="stat-label">Sterren</span>
              </div>
              <div class="stat">
                <span class="stat-number mono">3.233</span>
                <span class="stat-label">Volgers</span>
              </div>
            </div>
            <div class="voorgeschiedenis-proof">
              <Image
                src={vintedProfielOud}
                alt="Screenshot van het geblokkeerde Vinted-profiel @maud.hendrix: 5 sterren, 1881 verkopen, Gent, 3233 volgers"
                loading="lazy"
                widths={[380, 600, 900]}
                sizes="(max-width: 680px) 90vw, 340px"
              />
            </div>
          </div>
        </div>

        <div class="row row--dark">
          <span class="row-label label label--on-dark">Onderneming</span>
          <div class="row-body projects">
            <a
              class="project"
              href="https://www.vinted.be/member/306398525-studiomaud"
              target="_blank"
              rel="noopener"
            >
              <span class="project-number mono">01</span>
              <h3>Studio Maud</h3>
              <span class="project-status mono">Actief</span>
              <p>
                Data-gedreven tweedehands e-commerce op Vinted: 2.500+
                transacties, 774 orders in 2025 aan 56% brutomarge,
                verkopersbeoordeling 4,81/5. Sourcing, prijszetting,
                kwaliteitscontrole en logistiek allemaal in eigen beheer.
              </p>
              <span class="project-cta mono">Bekijk profiel →</span>
            </a>

            <div class="project project--closed">
              <span class="project-number mono">02</span>
              <h3>VintieBulk</h3>
              <span class="project-status project-status--closed mono">Afgerond</span>
              <p class="project-desc">
                B2B-aanbod van gecureerde partijen en resellerboxen met
                tweedehands Ralph Lauren.
              </p>
              <ul class="project-list">
                <li>
                  Bouwde het aanbod op eigen transactiedata en
                  verkoopervaring: gecureerde partijen samengesteld op wat
                  effectief verkoopt.
                </li>
                <li>
                  Bouwde de webshop, branding, content en klantencommunicatie
                  op.
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="row wrap traject">
      <span class="row-label label">Traject</span>
      <div class="row-body">
        <Timeline />
      </div>
    </section>

    <!-- 02 PRIVÉ -->
    <section class="world-section world-section--prive" id="prive">
      <div class="wrap world-intro">
        <span class="label">02 / Privé</span>
        <h2>Privé</h2>
        <p class="world-lede">
          Een verzameling van interesses, kleine ontdekkingen en dingen waar
          ik graag tijd voor maak.
        </p>
        <div class="world-links">
          <a class="btn" href="/prive">Volledige pagina →</a>
        </div>
      </div>

      <div class="row wrap">
        <span class="row-label label">Sociale kanalen</span>
        <div class="row-body">
          <p class="section-intro">Waar ik online rondhang, buiten Vinted.</p>
          <div class="socials">
            {
              socials.map((s) => (
                <a class="social" href={s.href} target="_blank" rel="noopener">
                  <span class="social-dot" aria-hidden="true" />
                  <h3>{s.name}</h3>
                  <p class="mono">{s.handle}</p>
                </a>
              ))
            }
          </div>
          <div class="countup-grid">
            <CountUp
              title="Pinterest"
              end={850}
              suffix="K"
              label="impressies per maand"
              href="https://pin.it/5QS0AwBzB"
              accent="mustard"
            />
            <CountUp
              title="TikTok"
              end={1.3}
              suffix="M"
              decimals={1}
              label="weergaven afgelopen jaar"
              href="https://www.tiktok.com/@hendrix.maud"
              accent="mustard"
            />
          </div>
        </div>
      </div>

      <div class="row wrap">
        <span class="row-label label">Interesses</span>
        <div class="row-body interests">
          {
            interests.map((i) => (
              <div class="interest">
                <h3>{i.title}</h3>
                <p>{i.desc}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="row wrap">
        <span class="row-label label">Gelezen</span>
        <div class="row-body">
          <Gelezen />
        </div>
      </div>

      <div class="row wrap row--last">
        <span class="row-label label">Fotografie</span>
        <div class="row-body">
          <PhotoGallery />
        </div>
      </div>
    </section>

    <section class="articles wrap" aria-labelledby="articles-title">
      <div class="articles-head">
        <span class="label">Artikelen</span>
        <h2 id="articles-title" class="articles-title">Uit de <em>praktijk</em></h2>
      </div>
      <ol class="article-list">
        {
          articles.map((a) => (
            <li>
              <a href={`/artikelen/${a.id}`} class="article-row">
                <time class="article-date mono" datetime={a.data.date}>
                  {formatDate(a.data.date)}
                </time>
                <div class="article-text">
                  {a.id === FEATURED_SLUG && <span class="article-featured mono">Uitgelicht</span>}
                  <h3>{a.data.title}</h3>
                  <p>{a.data.excerpt}</p>
                </div>
                <span class="article-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="home-contact wrap" id="contact">
      <span class="label">Contact</span>
      <div class="home-contact-row">
        <div class="mail-btn-wrap">
          <span class="mail-cat" aria-hidden="true">
            <svg width="58" height="32" viewBox="0 0 58 32" fill="none">
              <path d="M46 22c8 0 10-10 2-14" stroke="var(--rust)" stroke-width="4" stroke-linecap="round" fill="none"/>
              <ellipse cx="27" cy="22" rx="20" ry="9" fill="var(--rust)"/>
              <circle cx="11" cy="14" r="8" fill="var(--rust)"/>
              <polygon points="4,10 8,1 13,9" fill="var(--rust)"/>
              <polygon points="11,8 16,0 19,8" fill="var(--rust)"/>
              <circle cx="9" cy="14" r="1.4" fill="var(--paper)"/>
            </svg>
          </span>
          <button type="button" class="btn btn--solid" id="mail-reveal-btn" aria-expanded="false" aria-controls="email-reveal">
            Stuur een mail
          </button>
        </div>
        <div class="email-reveal" id="email-reveal">
          <div class="email-reveal-inner">
            <a href="mailto:StudioMaud@outlook.com" class="mono email-link">StudioMaud@outlook.com</a>
            <button type="button" class="copy-btn" id="copy-email-btn" aria-label="E-mailadres kopiëren">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <rect x="4.5" y="4.5" width="8" height="8" stroke="currentColor" stroke-width="1.4"/>
                <rect x="1.5" y="1.5" width="8" height="8" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <script>
      const revealBtn = document.getElementById("mail-reveal-btn");
      const reveal = document.getElementById("email-reveal");
      const copyBtn = document.getElementById("copy-email-btn");

      revealBtn?.addEventListener("click", () => {
        const isOpen = reveal?.classList.toggle("is-open");
        revealBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });

      copyBtn?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("StudioMaud@outlook.com");
          copyBtn.classList.add("copied");
          setTimeout(() => copyBtn.classList.remove("copied"), 1500);
        } catch {
          /* clipboard unavailable, mailto link still works */
        }
      });
    </script>

  </main>
  <StickyFooterBar subtitle="Criminologie · Ondernemerschap" />
</BaseLayout>

<style>
  .home {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--cream);
  }

  /* ---------- NAV ---------- */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--cream);
    border-bottom: 1px solid var(--ink);
  }
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 18px;
  }
  .nav-mark {
    font-size: 19px;
    font-weight: 900;
    text-decoration: none;
    color: var(--ink);
  }
  .nav-dot {
    color: var(--mustard);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 28px);
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--navy);
    opacity: 0.75;
  }
  .nav-links a:hover {
    opacity: 1;
  }
  @media (max-width: 560px) {
    .nav-links {
      gap: 14px;
      font-size: 11px;
    }
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    background: var(--mustard);
    padding-block: clamp(48px, 8vw, 96px) clamp(56px, 9vw, 108px);
    border-bottom: 1px solid var(--ink);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    column-gap: clamp(24px, 4vw, 64px);
    row-gap: 28px;
  }

  .hero-meta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .hero .eyebrow-index {
    color: var(--navy);
    opacity: 0.7;
  }

  .hero-title {
    grid-column: 1 / 8;
    font-size: clamp(58px, 11vw, 148px);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-statement {
    grid-column: 8 / 13;
    align-self: end;
    padding-top: 22px;
    border-top: 1px solid var(--ink);
    max-width: 40ch;
  }
  .hero-statement p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }

  .hero-cta {
    grid-column: 1 / -1;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-title,
    .hero-statement {
      grid-column: 1 / -1;
    }
    .hero-statement {
      max-width: none;
    }
  }

  /* ---------- WORLD SECTIONS (Professioneel / Privé) ---------- */
  .world-section--prive {
    background: var(--periwinkle);
  }

  .world-intro {
    padding-block: clamp(40px, 6vw, 72px) clamp(28px, 4vw, 40px);
  }
  .world-intro h2 {
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 800;
    margin-block: 14px 18px;
    line-height: 1.05;
  }
  .world-lede {
    font-size: 17px;
    line-height: 1.6;
    max-width: 62ch;
    margin-bottom: 24px;
  }
  .world-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* ---------- ROWS (gedeeld tussen secties) ---------- */
  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    padding-block: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--ink);
  }
  .row-label {
    padding-top: 4px;
  }
  .row-body {
    min-width: 0;
  }
  .row-body h3 {
    font-size: clamp(20px, 2.6vw, 26px);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .row-body > p {
    font-size: 16px;
    line-height: 1.6;
    max-width: 60ch;
  }
  .traject {
    border-bottom: 1px solid var(--ink);
  }

  @media (max-width: 680px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  /* EDUCATION */
  .education {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .edu-period {
    display: block;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--mustard-deep);
    margin-bottom: 8px;
  }
  .edu p {
    font-size: 15px;
    opacity: 0.85;
  }

  /* SKILLS */
  .skills-section {
    border-bottom: 1px solid var(--ink);
    padding-block: clamp(36px, 5vw, 56px) 0;
  }
  .skills-head {
    padding-bottom: 20px;
  }

  /* LANGUAGES & TOOLS */
  .langs-tools {
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: 44px;
  }
  .langs,
  .tools {
    min-width: 0;
  }
  .subhead {
    display: flex;
    margin-bottom: 18px;
  }
  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .lang-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--ink);
  }
  .lang-name {
    font-size: 17px;
    font-weight: 600;
  }
  .lang-level {
    font-size: 13px;
    color: var(--navy);
    white-space: nowrap;
  }
  @media (max-width: 780px) {
    .langs-tools {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* EXPERIENCE */
  .experience {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .exp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: 14px;
  }
  .exp-period {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--navy);
    opacity: 0.8;
    white-space: nowrap;
  }
  .exp-context {
    font-size: 15px;
    line-height: 1.6;
    max-width: 62ch;
    margin-bottom: 16px;
  }
  .exp ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 68ch;
  }
  .exp li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.55;
  }
  .exp li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    background: var(--mustard);
  }

  .inline-link {
    color: var(--navy);
    text-decoration: none;
