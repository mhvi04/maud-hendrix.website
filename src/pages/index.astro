---
import BaseLayout from "../layouts/BaseLayout.astro";
import StickyFooterBar from "../components/StickyFooterBar.astro";
import Typewriter from "../components/Typewriter.astro";
import InteractiePaneel from "../components/InteractiePaneel.astro";
import LanguagePicker from "../components/LanguagePicker.astro";

import { getCollection } from "astro:content";

// Zelfde uitgelicht artikel als op /artikelen: altijd bovenaan.
const FEATURED_SLUG = "boosten-op-vinted";

const articles = (await getCollection("articlesNl", ({ data }) => !data.draft)).sort((a, b) => {
  if (a.id === FEATURED_SLUG) return -1;
  if (b.id === FEATURED_SLUG) return 1;
  return b.data.date.localeCompare(a.data.date) || a.data.title.localeCompare(b.data.title);
});

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("nl-BE", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout title="Maud Hendrix" nlPath="/" enPath="/">
  <main class="home">
    <InteractiePaneel />
    <LanguagePicker locale="nl" nlPath="/" enPath="/" />

    <section class="hero">
      <div class="hero-shapes" aria-hidden="true">
        <span class="ring ring-a"></span>
        <span class="square sq-a"></span>
        <span class="triangle tri-a"></span>
        <span class="dot dot-a"></span>
        <span class="rule rule-a"></span>
        <span class="rule rule-b"></span>
      </div>

      <div class="wrap hero-grid">
        <div class="hero-meta">
          <span class="eyebrow-index mono">MH — GENT, BE</span>
        </div>

        <h1 class="hero-title" aria-label="Maud Hendrix">
          <Typewriter lines={["Maud", "Hendrix"]} minDelay={60} maxDelay={120} blinks={4} />
        </h1>

        <div class="hero-statement">
          <p>
            Criminologie leert me stilstaan bij waarom mensen doen wat ze
            doen. Mijn onderneming leert me dat in de praktijk brengen, dag na
            dag, cijfer na cijfer. Het is minder een masterplan dan een
            gewoonte die is blijven groeien.
          </p>
        </div>
      </div>
    </section>

    <section class="entries wrap" aria-label="Kies een ingang">
      <a href="/professioneel" class="entry entry--pro">
        <div class="entry-body">
          <span class="label label--on-mustard">01 / Professioneel</span>
          <h2>Professioneel</h2>
          <p>Studie, ondernemerschap en projecten.</p>
        </div>
        <span class="entry-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M3 15L15 3M15 3H6M15 3V12" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
          </svg>
        </span>
      </a>

      <a href="/prive" class="entry entry--prive">
        <div class="entry-body">
          <span class="label label--on-dark">02 / Privé</span>
          <h2>Privé</h2>
          <p>Interesses, inspiratie en sociale kanalen.</p>
        </div>
        <span class="entry-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M3 15L15 3M15 3H6M15 3V12" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
          </svg>
        </span>
      </a>
    </section>

    <section class="articles wrap" aria-labelledby="articles-title">
      <div class="articles-head">
        <span class="label">Artikelen</span>
        <h2 id="articles-title" class="articles-title">Uit de praktijk</h2>
      </div>
      <ol class="article-list">
        {
          articles.map((a) => (
            <li>
              <a href={`/artikelen/${a.id}`} class="article-row">
                <time class="article-date mono" datetime={a.data.date}>
                  {formatDate(a.data.date)}
                </time>
                <div class="article-text">
                  {a.id === FEATURED_SLUG && <span class="article-featured mono">Uitgelicht</span>}
                  <h3>{a.data.title}</h3>
                  <p>{a.data.excerpt}</p>
                </div>
                <span class="article-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="home-contact wrap">
      <span class="label">Contact</span>
      <div class="home-contact-row">
        <div class="mail-btn-wrap">
          <span class="mail-cat" aria-hidden="true">
            <svg width="58" height="32" viewBox="0 0 58 32" fill="none">
              <path d="M46 22c8 0 10-10 2-14" stroke="var(--rust)" stroke-width="4" stroke-linecap="round" fill="none"/>
              <ellipse cx="27" cy="22" rx="20" ry="9" fill="var(--rust)"/>
              <circle cx="11" cy="14" r="8" fill="var(--rust)"/>
              <polygon points="4,10 8,1 13,9" fill="var(--rust)"/>
              <polygon points="11,8 16,0 19,8" fill="var(--rust)"/>
              <circle cx="9" cy="14" r="1.4" fill="var(--paper)"/>
            </svg>
          </span>
          <button type="button" class="btn btn--solid" id="mail-reveal-btn" aria-expanded="false" aria-controls="email-reveal">
            Stuur een mail
          </button>
        </div>
        <div class="email-reveal" id="email-reveal">
          <div class="email-reveal-inner">
            <a href="mailto:StudioMaud@outlook.com" class="mono email-link">StudioMaud@outlook.com</a>
            <button type="button" class="copy-btn" id="copy-email-btn" aria-label="E-mailadres kopiëren">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <rect x="4.5" y="4.5" width="8" height="8" stroke="currentColor" stroke-width="1.4"/>
                <rect x="1.5" y="1.5" width="8" height="8" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <script>
      const revealBtn = document.getElementById("mail-reveal-btn");
      const reveal = document.getElementById("email-reveal");
      const copyBtn = document.getElementById("copy-email-btn");

      revealBtn?.addEventListener("click", () => {
        const isOpen = reveal?.classList.toggle("is-open");
        revealBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });

      copyBtn?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("StudioMaud@outlook.com");
          copyBtn.classList.add("copied");
          setTimeout(() => copyBtn.classList.remove("copied"), 1500);
        } catch {
          /* clipboard unavailable, mailto link still works */
        }
      });
    </script>

  </main>
  <StickyFooterBar subtitle="Criminologie · Ondernemerschap" />
</BaseLayout>

<style>
  .home {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--cream);
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    padding-block: clamp(48px, 8vw, 96px) clamp(56px, 9vw, 108px);
    overflow: hidden;
    border-bottom: 3px solid var(--ink);
  }

  .hero-shapes {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .ring {
    position: absolute;
    border-radius: 50%;
    border: 3px solid var(--navy);
  }
  .ring-a {
    width: 230px;
    height: 230px;
    top: -70px;
    right: 6%;
    border-color: var(--mustard);
    opacity: 0.9;
  }
  .square {
    position: absolute;
    background: var(--rust);
  }
  .sq-a {
    width: 70px;
    height: 70px;
    top: 14%;
    right: 30%;
    transform: rotate(8deg);
  }
  .triangle {
    position: absolute;
    width: 0;
    height: 0;
    border-left: 34px solid transparent;
    border-right: 34px solid transparent;
    border-bottom: 58px solid var(--navy);
  }
  .tri-a {
    top: 4%;
    right: 5%;
  }
  .dot {
    position: absolute;
    border-radius: 50%;
    background: var(--ink);
  }
  .dot-a {
    width: 14px;
    height: 14px;
    bottom: 10%;
    right: 24%;
  }
  .rule {
    position: absolute;
    background: var(--ink);
  }
  .rule-a {
    width: 2px;
    height: 130px;
    top: 8%;
    right: 22%;
    opacity: 0.5;
  }
  .rule-b {
    width: 90px;
    height: 2px;
    bottom: 14%;
    right: 4%;
    background: var(--mustard-deep);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 7fr 5fr;
    column-gap: clamp(24px, 4vw, 64px);
    row-gap: 28px;
  }

  .hero-meta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .hero-title {
    grid-column: 1 / 8;
    font-size: clamp(58px, 11vw, 148px);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .hero-statement {
    grid-column: 8 / 13;
    align-self: end;
    padding-top: 22px;
    border-top: 2px solid var(--ink);
    max-width: 40ch;
  }
  .hero-statement p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-title,
    .hero-statement {
      grid-column: 1 / -1;
    }
    .hero-statement {
      max-width: none;
    }
    .ring-a {
      width: 140px;
      height: 140px;
      top: -50px;
      right: -30px;
    }
    .tri-a,
    .rule-a,
    .rule-b,
    .dot-a,
    .sq-a {
      display: none;
    }
  }

  /* ---------- ENTRIES ---------- */
  .entries {
    width: 100%;
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: clamp(20px, 3vw, 36px);
    padding-block: clamp(28px, 5vw, 48px);
    align-items: stretch;
  }

  .entry {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    min-height: clamp(150px, 16vw, 190px);
    padding: clamp(22px, 2.5vw, 30px);
    border: 3px solid var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .entry:hover {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .entry:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }

  .entry--pro {
    background: var(--mustard);
    color: var(--ink);
  }
  .entry--prive {
    background: var(--navy);
    color: var(--paper);
    margin-top: clamp(0px, 4vw, 32px);
  }

  .entry--pro .label {
    color: var(--navy-deep);
  }
  .entry--pro .label::before {
    background: var(--ink);
  }
  .entry--prive .label {
    color: var(--mustard);
  }
  .entry--prive .label::before {
    background: var(--cream);
  }

  .entry-body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 34ch;
  }
  .entry h2 {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 600;
    color: inherit;
    line-height: 1;
  }
  .entry p {
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.92;
  }

  .entry-arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 2px solid var(--ink);
  }
  .entry--pro .entry-arrow {
    background: var(--navy);
    color: var(--cream);
  }
  .entry--prive .entry-arrow {
    background: var(--mustard);
    color: var(--ink);
  }
  @media (max-width: 780px) {
    .entries {
      grid-template-columns: 1fr;
    }
    .entry--prive {
      margin-top: 0;
    }
  }

  /* ---------- ARTIKELEN ---------- */
  .articles {
    width: 100%;
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: clamp(20px, 3vw, 36px);
    padding-block: clamp(8px, 2vw, 16px) clamp(40px, 6vw, 64px);
  }
  .articles-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .articles-title {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 600;
    line-height: 1.05;
  }
  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--ink);
  }
  .article-list li {
    border-bottom: 2px solid var(--ink);
  }
  .article-row {
    display: grid;
    grid-template-columns: 11ch 1fr auto;
    align-items: baseline;
    gap: clamp(14px, 2.4vw, 28px);
    padding: 18px 8px 18px 0;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.15s ease, padding 0.15s ease;
  }
  .article-row:hover,
  .article-row:focus-visible {
    background: var(--paper);
    padding-left: 12px;
  }
  .article-row:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .article-date {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--rust);
    white-space: nowrap;
  }
  .article-featured {
    display: inline-block;
    margin-bottom: 6px;
    padding: 2px 8px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--mustard);
    color: var(--ink);
  }
  .article-text h3 {
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 600;
    line-height: 1.25;
  }
  .article-text p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.85;
    max-width: 68ch;
  }
  .article-arrow {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--navy);
  }
  .article-row:hover .article-arrow {
    color: var(--rust);
  }

  @media (max-width: 780px) {
    .articles {
      grid-template-columns: 1fr;
    }
    .article-row {
      grid-template-columns: 1fr auto;
      row-gap: 6px;
    }
    .article-date {
      grid-column: 1 / -1;
    }
  }

  /* ---------- CONTACT ---------- */
  .home-contact {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: 4px clamp(32px, 5vw, 48px);
  }
  .home-contact-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .mail-btn-wrap {
    position: relative;
  }
  .mail-cat {
    position: absolute;
    top: -22px;
    right: -6px;
    transform: rotate(-6deg);
    pointer-events: none;
  }

  .email-reveal {
    max-width: 0;
    overflow: hidden;
    transition: max-width 0.3s ease;
  }
  .email-reveal.is-open {
    max-width: 320px;
  }
  .email-reveal-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    width: max-content;
    border: 2px solid var(--ink);
    padding: 13px 16px;
  }
  .email-link {
    font-size: 14px;
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--navy);
  }
  .email-link:hover {
    color: var(--rust);
    border-color: var(--rust);
  }
  .copy-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border: none;
    background: transparent;
    color: var(--navy);
    padding: 0;
  }
  .copy-btn:hover {
    color: var(--rust);
  }
  .copy-btn.copied {
    color: var(--mustard-deep);
  }

</style>
