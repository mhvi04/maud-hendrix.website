---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BrainNetwork from "../components/BrainNetwork.astro";
---

<BaseLayout
  title="Explore my brain — Maud Hendrix"
  description="Een visuele kaart van hoe criminologie, data, ondernemen en design voor mij samenhangen."
>
  <SiteHeader world="explore" />

  <main class="brain-page">
    <section class="intro">
      <div class="wrap intro-grid">
        <div class="intro-copy">
          <h1>Explore my brain</h1>
          <p class="intro-lede">
            I tend to connect things that don't immediately seem connected.
          </p>
        </div>
      </div>
    </section>

    <section class="row wrap row--last">
      <BrainNetwork />
    </section>
  </main>

  <SiteFooter world="pro" />
</BaseLayout>

<style>
  .brain-page {
    background: var(--cream);
  }

  .intro {
    border-bottom: 3px solid var(--ink);
    padding-block: clamp(48px, 7vw, 88px);
  }
  .intro-copy {
    max-width: 62ch;
  }
  .intro-copy h1 {
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 600;
    line-height: 1.05;
    color: var(--navy);
  }
  .intro-lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.5;
    color: var(--navy);
    margin-top: 16px;
  }

  .row {
    padding-block: clamp(36px, 5vw, 56px);
  }
  .row--last {
    border-bottom: 3px solid var(--ink);
  }
</style>
