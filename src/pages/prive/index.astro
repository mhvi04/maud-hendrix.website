---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StickyFooterBar from "../../components/StickyFooterBar.astro";
import CountUp from "../../components/CountUp.astro";
import Gelezen from "../../components/Gelezen.astro";

const interests = [
  { title: "Muurklimmen", desc: "Probleemoplossen, één beweging tegelijk." },
  { title: "Koken", desc: "Recepten als richtlijn, nooit als wet." },
  { title: "Fotografie", desc: "Details vastleggen die anders onopgemerkt blijven." },
];
---

<BaseLayout
  title="Privé — Maud Hendrix"
  description="Interesses, sociale kanalen en blog van Maud Hendrix."
>
  <SiteHeader world="prive" />

  <main class="prive">
    <section class="intro">
      <div class="wrap intro-grid">
        <div class="intro-copy">
          <h1>Ook <em>Maud.</em></h1>
          <p class="intro-lede">Kattenmoeder en muurklimmer.</p>
          <div class="pill-bar" aria-hidden="true">
            <span class="pill-bar-item pill-bar-item--navy"></span>
            <span class="pill-bar-item pill-bar-item--mustard"></span>
            <span class="pill-bar-item pill-bar-item--navy"></span>
            <span class="pill-bar-item pill-bar-item--mustard"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="row wrap">
      <span class="row-label letter accent">A</span>
      <div class="row-body">
        <h3>Sociale kanalen</h3>
        <p class="section-intro">Waar ik online rondhang, buiten Vinted.</p>
        <div class="link-list">
          <a href="https://www.instagram.com/hendrix.maud" target="_blank" rel="noopener">Instagram · @hendrix.maud</a>
          <a href="https://www.tiktok.com/@hendrix.maud" target="_blank" rel="noopener">TikTok · @hendrix.maud</a>
          <a href="https://pin.it/5QS0AwBzB" target="_blank" rel="noopener">Pinterest</a>
        </div>
        <div class="countup-grid">
          <CountUp
            title="Pinterest"
            end={850}
            suffix="K"
            label="impressies per maand"
            href="https://pin.it/5QS0AwBzB"
            accent="mustard"
          />
          <CountUp
            title="TikTok"
            end={1.3}
            suffix="M"
            decimals={1}
            label="weergaven afgelopen jaar"
            href="https://www.tiktok.com/@hendrix.maud"
            accent="mustard"
          />
        </div>
      </div>
    </section>

    <section class="row wrap">
      <span class="row-label label">Interesses</span>
      <div class="row-body interests">
        {
          interests.map((i) => (
            <div class="interest">
              <h3>{i.title}</h3>
              <p>{i.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="row wrap">
      <span class="row-label letter accent">B</span>
      <div class="row-body">
        <h3>Blog</h3>
        <div class="link-list">
          <a href="/artikelen/">Naar de blog</a>
        </div>
      </div>
    </section>

    <section class="row wrap row--last">
      <span class="row-label label">Gelezen</span>
      <div class="row-body">
        <Gelezen />
      </div>
    </section>
  </main>

  <StickyFooterBar />
</BaseLayout>

<style>
  .prive {
    background: var(--cream);
  }

  .intro {
    border-bottom: 1px solid var(--ink);
    padding-block: clamp(48px, 7vw, 88px);
    position: relative;
  }
  .intro-grid {
    position: relative;
  }
  .intro-copy {
    position: relative;
    z-index: 1;
    max-width: 62ch;
  }
  .intro-copy h1 {
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 800;
    line-height: 1.05;
  }
  .intro-lede {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink);
    margin-top: 14px;
  }
  .pill-bar {
    display: flex;
    height: 64px;
    margin-top: 28px;
    max-width: 320px;
  }
  .pill-bar-item {
    width: 60px;
    height: 100%;
    margin-left: -1px;
  }
  .pill-bar-item--navy {
    background: var(--navy);
    border-radius: 0 60px 60px 0;
  }
  .pill-bar-item--mustard {
    background: var(--mustard);
    border-radius: 60px 0 0 60px;
  }

  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    padding-block: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--ink);
  }
  .row--last {
    border-bottom: 1px solid var(--ink);
  }
  .row-label {
    padding-top: 4px;
  }
  .row-label.letter {
    font-size: 24px;
    padding-top: 0;
  }
  .row-body {
    min-width: 0;
  }
  .row-body h3 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  @media (max-width: 680px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  .section-intro {
    font-size: 16px;
    margin-bottom: 22px;
  }

  .link-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 16px;
    margin-bottom: 20px;
  }
  .link-list a {
    width: fit-content;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .countup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .interests {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .interest {
    border: 1px solid var(--ink);
    padding: 24px;
    background: var(--paper);
  }
  .interest h3 {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .interest p {
    font-size: 14px;
    line-height: 1.55;
  }
</style>
