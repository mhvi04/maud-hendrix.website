---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StickyFooterBar from "../../components/StickyFooterBar.astro";
import CountUp from "../../components/CountUp.astro";
import PhotoGallery from "../../components/PhotoGallery.astro";
import Gelezen from "../../components/Gelezen.astro";

const socials = [
  {
    name: "Instagram",
    handle: "@hendrix.maud",
    href: "https://www.instagram.com/hendrix.maud",
  },
  {
    name: "LinkedIn",
    handle: "maud-hendrix-522245374",
    href: "https://www.linkedin.com/in/maud-hendrix-522245374",
  },
];

const interests = [
  { title: "Muurklimmen", desc: "Probleemoplossen, één beweging tegelijk." },
  { title: "Koken", desc: "Recepten als richtlijn, nooit als wet." },
  { title: "Fotografie", desc: "Details vastleggen die anders onopgemerkt blijven." },
];
---

<BaseLayout
  title="Privé — Maud Hendrix"
  description="Interesses, sociale kanalen en blog van Maud Hendrix."
>
  <SiteHeader world="prive" />

  <main class="prive">
    <section class="intro">
      <div class="wrap intro-grid">
        <span class="intro-shape" aria-hidden="true"></span>
        <div class="intro-copy">
          <h1>Privé</h1>
          <p class="intro-lede">
            Een verzameling van interesses, kleine ontdekkingen en dingen
            waar ik graag tijd voor maak.
          </p>
        </div>
      </div>
    </section>

    <section class="row wrap">
      <span class="row-label label">Sociale kanalen</span>
      <div class="row-body">
        <p class="section-intro">Waar ik online rondhang, buiten Vinted.</p>
        <div class="socials">
        {
          socials.map((s) => (
            <a class="social" href={s.href} target="_blank" rel="noopener">
              <span class="social-dot" aria-hidden="true" />
              <h3>{s.name}</h3>
              <p class="mono">{s.handle}</p>
            </a>
          ))
        }
        </div>
        <div class="countup-grid">
          <CountUp
            title="Pinterest"
            end={850}
            suffix="K"
            label="impressies per maand"
            href="https://pin.it/5QS0AwBzB"
            accent="mustard"
          />
          <CountUp
            title="TikTok"
            end={1.3}
            suffix="M"
            decimals={1}
            label="weergaven afgelopen jaar"
            href="https://www.tiktok.com/@hendrix.maud"
            accent="mustard"
          />
        </div>
      </div>
    </section>

    <section class="row wrap">
      <span class="row-label label">Interesses</span>
      <div class="row-body interests">
        {
          interests.map((i) => (
            <div class="interest">
              <h3>{i.title}</h3>
              <p>{i.desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="row wrap">
      <span class="row-label label">Gelezen</span>
      <div class="row-body">
        <Gelezen />
      </div>
    </section>

    <section class="row wrap row--last">
      <span class="row-label label">Fotografie</span>
      <div class="row-body">
        <PhotoGallery />
      </div>
    </section>
  </main>

  <StickyFooterBar />
</BaseLayout>

<style>
  .prive {
    background: var(--cream);
  }

  .intro {
    border-bottom: 1px solid var(--ink);
    padding-block: clamp(48px, 7vw, 88px);
    position: relative;
  }
  .intro-grid {
    position: relative;
  }
  .intro-copy {
    position: relative;
    z-index: 1;
    max-width: 62ch;
  }
  .intro-copy h1 {
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 600;
    line-height: 1.05;
  }
  .intro-lede {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
    margin-top: 14px;
  }
  .intro-shape {
    display: none;
  }

  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    padding-block: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--ink);
  }
  .row--last {
    border-bottom: 1px solid var(--ink);
  }
  .row-label {
    padding-top: 4px;
  }
  .row-body {
    min-width: 0;
  }
  @media (max-width: 680px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  .section-intro {
    font-size: 16px;
    margin-bottom: 22px;
  }

  .socials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 20px;
  }

  .countup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .social {
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  .social:hover {
    transform: translateY(-2px);
    box-shadow: none;
    background: var(--cream);
  }
  .social-dot {
    display: block;
    width: 16px;
    height: 16px;
    background: var(--rust);
    margin-bottom: 18px;
  }
  .social h3 {
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .social p {
    font-size: 13px;
    color: var(--navy);
    opacity: 0.85;
  }

  .interests {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .interest {
    border: 1px solid var(--ink);
    padding: 24px;
    background: var(--paper);
  }
  .interest h3 {
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .interest p {
    font-size: 14px;
    line-height: 1.55;
  }

</style>
