---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles")).filter(
  (a) => a.data.world === "prive"
);
---

<BaseLayout title="Blog — Maud Hendrix">
  <SiteHeader world="prive" />
  <main class="listing">
    <section class="wrap head">
      <span class="label">Privé</span>
      <h1>Blog</h1>
    </section>
    <section class="wrap grid">
      {
        articles.length === 0 ? (
          <div class="empty-state">
            <span class="mono">Binnenkort</span>
            <p>Hier komen binnenkort blogposts te staan.</p>
          </div>
        ) : (
          articles.map((a) => (
            <a class="card" href={`/prive/blog/${a.slug}`}>
              <span class="mono card-tag">{a.data.tag}</span>
              <h3>{a.data.title}</h3>
              <p>{a.data.excerpt}</p>
            </a>
          ))
        )
      }
    </section>
  </main>
  <SiteFooter world="prive" />
</BaseLayout>

<style>
  .listing {
    background: var(--cream);
  }
  .head {
    padding-block: clamp(48px, 7vw, 84px) clamp(32px, 5vw, 48px);
    border-bottom: 3px solid var(--ink);
  }
  .head h1 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 600;
    margin-top: 14px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
    padding-block: clamp(32px, 5vw, 56px);
  }
  .empty-state {
    grid-column: 1 / -1;
    border: 2px dashed var(--ink);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 46ch;
  }
  .empty-state .mono {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 3px solid var(--ink);
    background: var(--paper);
    padding: 26px;
    text-decoration: none;
    color: var(--ink);
  }
  .card-tag {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rust);
  }
</style>
