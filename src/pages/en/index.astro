---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StickyFooterBar from "../../components/StickyFooterBar.astro";
import Typewriter from "../../components/Typewriter.astro";
import InteractiePaneel from "../../components/InteractiePaneel.astro";
import LanguagePicker from "../../components/LanguagePicker.astro";
import Timeline from "../../components/Timeline.astro";
import SkillsMarquee from "../../components/SkillsMarquee.astro";
import ToolsPattern from "../../components/ToolsPattern.astro";
import { Image } from "astro:assets";
import vintedProfielOud from "../../assets/proof/vinted-profiel-oud.jpg";

import { getCollection } from "astro:content";

// Same featured article as on /en/articles: always pinned to the top.
const FEATURED_SLUG = "boosten-op-vinted";

const articles = (await getCollection("articlesEn", ({ data }) => !data.draft)).sort((a, b) => {
  if (a.id === FEATURED_SLUG) return -1;
  if (b.id === FEATURED_SLUG) return 1;
  return b.data.date.localeCompare(a.data.date) || a.data.title.localeCompare(b.data.title);
});

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<BaseLayout title="Maud Hendrix" locale="en" nlPath="/" enPath="/">
  <main class="home">
    <nav class="site-nav" id="top">
      <div class="wrap nav-bar">
        <a href="#top" class="nav-mark">mh<span class="nav-dot">.</span></a>
        <div class="nav-right">
          <div class="nav-links mono">
            <a href="#professional">Professional</a>
            <a href="/en/articles/">Articles</a>
            <a href="#contact">Contact</a>
          </div>
          <LanguagePicker locale="en" nlPath="/" enPath="/" inline />
          <InteractiePaneel inline />
        </div>
      </div>
    </nav>

    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-meta">
          <span class="eyebrow-index mono">MH — GHENT, BE</span>
        </div>

        <h1 class="hero-title" aria-label="Maud Hendrix">
          <Typewriter lines={["Maud", "Hendrix"]} minDelay={60} maxDelay={120} blinks={4} />
        </h1>

        <div class="hero-statement">
          <p>
            Criminology teaches me to pause and ask why people do what they
            do. My business teaches me to put that into practice, day after
            day, figure after figure. It's less a master plan than a habit
            that kept growing.
          </p>
        </div>

        <div class="hero-cta">
          <a class="btn btn--solid" href="#professional">Professional ↓</a>
        </div>
      </div>
    </section>

    <!-- PROFESSIONAL -->
    <section class="world-section" id="professional">
      <div class="wrap world-intro">
        <span class="label">Profile</span>
        <h2>I'm Maud Hendrix</h2>
        <p class="world-lede">
          I'm a Criminological Sciences student at Ghent University and a
          self-employed student in second-hand e-commerce. Criminology
          teaches me to analyse behaviour and systems. In my business, I
          apply that same way of thinking every day to data, pricing,
          buying behaviour and operational decisions. That's how I combine
          my academic background with hands-on experience from more than
          2,500 transactions.
        </p>
        <div class="world-links">
          <a
            class="btn btn--solid"
            href="https://www.linkedin.com/in/maud-hendrix-522245374"
            target="_blank"
            rel="noopener">LinkedIn</a
          >
          <a class="btn" href="/en/professional/">Full page →</a>
        </div>
      </div>

      <div class="row wrap">
        <span class="row-label label">Education</span>
        <div class="row-body education">
          <div class="edu">
            <span class="edu-period mono">2021 — expected 2026</span>
            <h3>Bachelor's in Criminological Sciences — Ghent University</h3>
          </div>
          <div class="edu">
            <span class="edu-period mono">Graduated 2022</span>
            <h3>Humanities — GO! Atheneum Voskenslaan, Ghent</h3>
            <p>Graduated with great distinction (cum laude).</p>
          </div>
        </div>
      </div>

      <div class="skills-section">
        <div class="wrap skills-head">
          <span class="row-label label">Skills</span>
        </div>
        <SkillsMarquee locale="en" />
      </div>

      <div class="row wrap">
        <span class="row-label label">Languages & Tools</span>
        <div class="row-body langs-tools">
          <div class="langs">
            <span class="subhead label">Languages</span>
            <ul class="lang-list">
              <li class="lang-row">
                <span class="lang-name">Dutch</span>
                <span class="lang-level mono">C2 · native</span>
              </li>
              <li class="lang-row">
                <span class="lang-name">English</span>
                <span class="lang-level mono">B2</span>
              </li>
              <li class="lang-row">
                <span class="lang-name">French</span>
                <span class="lang-level mono">A2</span>
              </li>
            </ul>
          </div>
          <div class="tools">
            <span class="subhead label">Software &amp; tools</span>
            <ToolsPattern locale="en" />
          </div>
        </div>
      </div>

      <div class="row wrap">
        <span class="row-label label">Experience</span>
        <div class="row-body experience">
          <article class="exp">
            <div class="exp-head">
              <h3>Self-employed student — second-hand e-commerce</h3>
              <span class="exp-period mono">February 2025 — present</span>
            </div>
            <p class="exp-context">
              Ghent and surrounding area. Officially self-employed since
              February 2025, active in trading since I was fourteen.
            </p>
            <ul>
              <li>
                More than 2,500 transactions, from sourcing and pricing to
                quality control, sales and logistics, all handled in-house.
              </li>
              <li>
                A custom analytics framework for purchase prices, margins,
                inventory turnover, category performance and seasonal effects
                drives every buying and pricing decision.
              </li>
              <li>
                Authenticity and quality control on branded clothing, with
                Ralph Lauren as the main category.
              </li>
            </ul>
          </article>

          <article class="exp exp--closed">
            <div class="exp-head">
              <h3>Co-founder — VintieBulk</h3>
              <span class="exp-period mono">Wound down</span>
            </div>
            <p class="exp-context">
              B2B offering of curated lots and reseller boxes of second-hand
              Ralph Lauren.
            </p>
            <ul>
              <li>
                Built the offering on my own transaction data and sales
                experience: curated lots assembled around what actually sells.
              </li>
              <li>Built the webshop, branding, content and customer communication.</li>
            </ul>
          </article>
        </div>
      </div>

      <div class="row wrap">
        <span class="row-label label">Backstory</span>
        <div class="row-body voorgeschiedenis-body">
          <p>
            I built my reputation through
            <a
              class="inline-link"
              href="https://www.vinted.be/member/38856549-maudhendrix"
              target="_blank"
              rel="noopener">@maud.hendrix</a
            >&nbsp;on Vinted: <span class="mono">1,881</span> sales,
            <span class="mono">5</span> stars, <span class="mono">3,233</span>
            followers, until the account got banned. Studio Maud is the
            sequel.
          </p>
          <div class="voorgeschiedenis-proof">
            <Image
              src={vintedProfielOud}
              alt="Screenshot of the banned Vinted profile @maud.hendrix: 5 stars, 1,881 sales, Ghent, 3,233 followers"
              loading="lazy"
              widths={[380, 600, 900]}
              sizes="(max-width: 680px) 90vw, 340px"
            />
          </div>
        </div>
      </div>

      <div class="row wrap">
        <span class="row-label label">Business</span>
        <div class="row-body projects">
          <a
            class="project"
            href="https://www.vinted.be/member/306398525-studiomaud"
            target="_blank"
            rel="noopener"
          >
            <span class="project-status mono">Active</span>
            <h3>Studio Maud</h3>
            <p>
              Data-driven second-hand e-commerce on Vinted: 2,500+
              transactions, 774 orders in 2025 at a 56% gross margin, seller
              rating 4.81/5. Sourcing, pricing, quality control and logistics,
              all handled in-house.
            </p>
            <span class="project-cta mono">View profile →</span>
          </a>
        </div>
      </div>

      <div class="row wrap traject">
        <span class="row-label label">Journey</span>
        <div class="row-body">
          <Timeline locale="en" />
        </div>
      </div>
    </section>

    <section class="articles wrap" aria-labelledby="articles-title">
      <div class="articles-head">
        <span class="label">Articles</span>
        <h2 id="articles-title" class="articles-title">From the <em>field</em></h2>
      </div>
      <ol class="article-list">
        {
          articles.map((a) => (
            <li>
              <a href={`/en/articles/${a.id}/`} class="article-row">
                <time class="article-date mono" datetime={a.data.date}>
                  {formatDate(a.data.date)}
                </time>
                <div class="article-text">
                  {a.id === FEATURED_SLUG && <span class="article-featured mono">Featured</span>}
                  <h3>{a.data.title}</h3>
                  <p>{a.data.excerpt}</p>
                </div>
                <span class="article-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="home-contact wrap" id="contact">
      <span class="label">Contact</span>
      <div class="home-contact-row">
        <div class="mail-btn-wrap">
          <span class="mail-cat" aria-hidden="true">
            <svg width="58" height="32" viewBox="0 0 58 32" fill="none">
              <path d="M46 22c8 0 10-10 2-14" stroke="var(--rust)" stroke-width="4" stroke-linecap="round" fill="none"/>
              <ellipse cx="27" cy="22" rx="20" ry="9" fill="var(--rust)"/>
              <circle cx="11" cy="14" r="8" fill="var(--rust)"/>
              <polygon points="4,10 8,1 13,9" fill="var(--rust)"/>
              <polygon points="11,8 16,0 19,8" fill="var(--rust)"/>
              <circle cx="9" cy="14" r="1.4" fill="var(--paper)"/>
            </svg>
          </span>
          <button type="button" class="btn btn--solid" id="mail-reveal-btn" aria-expanded="false" aria-controls="email-reveal">
            Send an email
          </button>
        </div>
        <div class="email-reveal" id="email-reveal">
          <div class="email-reveal-inner">
            <a href="mailto:StudioMaud@outlook.com" class="mono email-link">StudioMaud@outlook.com</a>
            <button type="button" class="copy-btn" id="copy-email-btn" aria-label="Copy email address">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <rect x="4.5" y="4.5" width="8" height="8" stroke="currentColor" stroke-width="1.4"/>
                <rect x="1.5" y="1.5" width="8" height="8" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <script>
      const revealBtn = document.getElementById("mail-reveal-btn");
      const reveal = document.getElementById("email-reveal");
      const copyBtn = document.getElementById("copy-email-btn");

      revealBtn?.addEventListener("click", () => {
        const isOpen = reveal?.classList.toggle("is-open");
        revealBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
      });

      copyBtn?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText("StudioMaud@outlook.com");
          copyBtn.classList.add("copied");
          setTimeout(() => copyBtn.classList.remove("copied"), 1500);
        } catch {
          /* clipboard unavailable, mailto link still works */
        }
      });
    </script>

  </main>
  <StickyFooterBar subtitle="Criminology · Entrepreneurship" />
</BaseLayout>

<style>
  .home {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--cream);
  }

  /* ---------- NAV ---------- */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--cream);
    border-bottom: 1px solid var(--ink);
  }
  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 18px;
  }
  .nav-mark {
    font-size: 19px;
    font-weight: 900;
    text-decoration: none;
    color: var(--ink);
  }
  .nav-dot {
    color: var(--mustard);
  }
  .nav-right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    row-gap: 10px;
    gap: clamp(14px, 2.5vw, 24px);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 28px);
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--navy);
    opacity: 0.75;
  }
  .nav-links a:hover {
    opacity: 1;
  }
  @media (max-width: 780px) {
    .nav-bar {
      flex-wrap: wrap;
      row-gap: 12px;
    }
    .nav-right {
      width: 100%;
      justify-content: space-between;
    }
  }
  @media (max-width: 560px) {
    .nav-links {
      gap: 14px;
      font-size: 11px;
    }
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    background: var(--mustard);
    padding-block: clamp(48px, 8vw, 96px) clamp(56px, 9vw, 108px);
    border-bottom: 1px solid var(--ink);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    column-gap: clamp(24px, 4vw, 64px);
    row-gap: 28px;
  }

  .hero-meta {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .hero .eyebrow-index {
    color: var(--navy);
    opacity: 0.7;
  }

  .hero-title {
    grid-column: 1 / 8;
    font-size: clamp(58px, 11vw, 148px);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-statement {
    grid-column: 8 / 13;
    align-self: end;
    padding-top: 22px;
    border-top: 1px solid var(--ink);
    max-width: 40ch;
  }
  .hero-statement p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink);
  }

  .hero-cta {
    grid-column: 1 / -1;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-title,
    .hero-statement {
      grid-column: 1 / -1;
    }
    .hero-statement {
      max-width: none;
    }
  }

  /* ---------- WORLD SECTION (Professional) ---------- */
  .world-intro {
    padding-block: clamp(40px, 6vw, 72px) clamp(28px, 4vw, 40px);
  }
  .world-intro h2 {
    font-size: clamp(32px, 4.5vw, 52px);
    font-weight: 800;
    margin-block: 14px 18px;
    line-height: 1.05;
  }
  .world-lede {
    font-size: 17px;
    line-height: 1.6;
    max-width: 62ch;
    margin-bottom: 24px;
  }
  .world-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* ---------- ROWS ---------- */
  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    padding-block: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--ink);
  }
  .row-label {
    padding-top: 4px;
  }
  .row-body {
    min-width: 0;
  }
  .row-body h3 {
    font-size: clamp(20px, 2.6vw, 26px);
    font-weight: 700;
    margin-bottom: 12px;
  }
  .row-body > p {
    font-size: 16px;
    line-height: 1.6;
    max-width: 60ch;
  }
  .traject {
    border-bottom: 1px solid var(--ink);
  }

  @media (max-width: 680px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  /* EDUCATION */
  .education {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .edu-period {
    display: block;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--mustard-deep);
    margin-bottom: 8px;
  }
  .edu p {
    font-size: 15px;
    opacity: 0.85;
  }

  /* SKILLS */
  .skills-section {
    border-bottom: 1px solid var(--ink);
    padding-block: clamp(36px, 5vw, 56px) 0;
  }
  .skills-head {
    padding-bottom: 20px;
  }

  /* LANGUAGES & TOOLS */
  .langs-tools {
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: 44px;
  }
  .langs,
  .tools {
    min-width: 0;
  }
  .subhead {
    display: flex;
    margin-bottom: 18px;
  }
  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .lang-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--ink);
  }
  .lang-name {
    font-size: 17px;
    font-weight: 600;
  }
  .lang-level {
    font-size: 13px;
    color: var(--navy);
    white-space: nowrap;
  }
  @media (max-width: 780px) {
    .langs-tools {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* EXPERIENCE */
  .experience {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .exp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: 14px;
  }
  .exp-period {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--navy);
    opacity: 0.8;
    white-space: nowrap;
  }
  .exp--closed .exp-period {
    color: var(--rust);
    opacity: 1;
  }
  .exp-context {
    font-size: 15px;
    line-height: 1.6;
    max-width: 62ch;
    margin-bottom: 16px;
  }
  .exp ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 68ch;
  }
  .exp li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.55;
  }
  .exp li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    background: var(--mustard);
  }
  .exp--closed li::before {
    background: var(--rust);
  }

  .inline-link {
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--navy);
  }
  .inline-link:hover {
    color: var(--rust);
    border-color: var(--rust);
  }

  .voorgeschiedenis-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 28px;
  }
  .voorgeschiedenis-body p {
    flex: 1 1 320px;
  }
  .voorgeschiedenis-proof {
    flex: 0 1 340px;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 10px;
    min-width: 0;
  }
  .voorgeschiedenis-proof :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* PROJECTS */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 26px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease;
  }
  a.project:hover {
    transform: translateY(-2px);
  }
  .project-status {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }
  .project h3 {
    font-size: 21px;
    font-weight: 700;
  }
  .project p {
    font-size: 14px;
    line-height: 1.55;
  }
  .project-cta {
    margin-top: auto;
    font-size: 12px;
    padding-top: 8px;
    color: var(--navy);
  }

  /* ---------- ARTICLES ---------- */
  .articles {
    width: 100%;
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: clamp(20px, 3vw, 36px);
    padding-block: clamp(40px, 6vw, 64px);
    border-bottom: 1px solid var(--ink);
  }
  .articles-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .articles-title {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    line-height: 1.05;
  }
  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .article-list li {
    border-bottom: 1px solid var(--ink);
  }
  .article-row {
    display: grid;
    grid-template-columns: 11ch 1fr auto;
    align-items: baseline;
    gap: clamp(14px, 2.4vw, 28px);
    padding: 18px 8px 18px 0;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.15s ease, padding 0.15s ease;
  }
  .article-row:hover,
  .article-row:focus-visible {
    background: var(--paper);
    padding-left: 12px;
  }
  .article-date {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--rust);
    white-space: nowrap;
  }
  .article-featured {
    display: inline-block;
    margin-bottom: 6px;
    padding: 2px 8px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--mustard);
    color: var(--ink);
  }
  .article-text h3 {
    font-size: clamp(17px, 1.8vw, 20px);
    font-weight: 700;
    line-height: 1.25;
  }
  .article-text p {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.85;
    max-width: 68ch;
  }
  .article-arrow {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--navy);
  }
  .article-row:hover .article-arrow {
    color: var(--rust);
  }
