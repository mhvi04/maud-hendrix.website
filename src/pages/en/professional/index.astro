---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import StickyFooterBar from "../../../components/StickyFooterBar.astro";
import Timeline from "../../../components/Timeline.astro";
import SkillsMarquee from "../../../components/SkillsMarquee.astro";
import ToolsPattern from "../../../components/ToolsPattern.astro";
import { Image } from "astro:assets";
import vintedProfielOud from "../../../assets/proof/vinted-profiel-oud.jpg";
---

<BaseLayout
  title="Professional — Maud Hendrix"
  description="Criminology, entrepreneurship and projects by Maud Hendrix."
  locale="en"
  nlPath="/professioneel"
  enPath="/professional"
>
  <SiteHeader world="pro" locale="en" nlPath="/professioneel" enPath="/professional" />

  <main class="pro">
    <!-- INTRO -->
    <section class="intro">
      <div class="wrap intro-grid">
        <span class="block-mark" aria-hidden="true"></span>
        <div class="intro-copy">
          <span class="label">Profile</span>
          <h1>I'm Maud Hendrix</h1>
          <p class="lede">
            I'm a Criminological Sciences student at Ghent University and a
            self-employed student in second-hand e-commerce. Criminology
            teaches me to analyse behaviour and systems. In my business, I
            apply that same way of thinking every day to data, pricing,
            buying behaviour and operational decisions. That's how I combine
            my academic background with hands-on experience from more than
            2,500 transactions.
          </p>
          <div class="intro-links">
            <a
              class="btn btn--solid"
              href="https://www.linkedin.com/in/maud-hendrix-522245374"
              target="_blank"
              rel="noopener">LinkedIn</a
            >
          </div>
        </div>
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="row wrap">
      <span class="row-label label">Education</span>
      <div class="row-body education">
        <div class="edu">
          <span class="edu-period mono">2021 — expected 2026</span>
          <h2>Bachelor's in Criminological Sciences — Ghent University</h2>
        </div>
        <div class="edu">
          <span class="edu-period mono">Graduated 2022</span>
          <h2>Humanities — GO! Atheneum Voskenslaan, Ghent</h2>
          <p>Graduated with great distinction (cum laude).</p>
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section class="skills-section">
      <div class="wrap skills-head">
        <span class="row-label label">Skills</span>
      </div>
      <SkillsMarquee locale="en" />
    </section>

    <!-- LANGUAGES & TOOLS -->
    <section class="row wrap">
      <span class="row-label label">Languages & Tools</span>
      <div class="row-body langs-tools">
        <div class="langs">
          <span class="subhead label">Languages</span>
          <ul class="lang-list">
            <li class="lang-row">
              <span class="lang-name">Dutch</span>
              <span class="lang-level mono">C2 · native</span>
            </li>
            <li class="lang-row">
              <span class="lang-name">English</span>
              <span class="lang-level mono">B2</span>
            </li>
            <li class="lang-row">
              <span class="lang-name">French</span>
              <span class="lang-level mono">A2</span>
            </li>
          </ul>
        </div>
        <div class="tools">
          <span class="subhead label">Software &amp; tools</span>
          <ToolsPattern locale="en" />
        </div>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="row wrap">
      <span class="row-label label">Experience</span>
      <div class="row-body experience">
        <article class="exp">
          <div class="exp-head">
            <h2>Self-employed student — second-hand e-commerce</h2>
            <span class="exp-period mono">February 2025 — present</span>
          </div>
          <p class="exp-context">
            Ghent and surrounding area. Officially self-employed since
            February 2025, active in trading since I was fourteen.
          </p>
          <ul>
            <li>
              More than 2,500 transactions, from sourcing and pricing to
              quality control, sales and logistics, all handled in-house.
            </li>
            <li>
              A custom analytics framework for purchase prices, margins,
              inventory turnover, category performance and seasonal effects
              drives every buying and pricing decision.
            </li>
            <li>
              Authenticity and quality control on branded clothing, with
              Ralph Lauren as the main category.
            </li>
          </ul>
        </article>

        <article class="exp exp--closed">
          <div class="exp-head">
            <h2>Co-founder — VintieBulk</h2>
            <span class="exp-period mono">Wound down</span>
          </div>
          <p class="exp-context">
            B2B offering of curated lots and reseller boxes of second-hand
            Ralph Lauren.
          </p>
          <ul>
            <li>
              Built the offering on my own transaction data and sales
              experience: curated lots assembled around what actually sells.
            </li>
            <li>Built the webshop, branding, content and customer communication.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- BACKSTORY -->
    <section class="row wrap">
      <span class="row-label label">Backstory</span>
      <div class="row-body voorgeschiedenis-body">
        <p>
          I built my reputation through
          <a
            class="inline-link"
            href="https://www.vinted.be/member/38856549-maudhendrix"
            target="_blank"
            rel="noopener">@maud.hendrix</a
          >
          on Vinted: <span class="mono">1,881</span> sales,
          <span class="mono">5</span> stars, <span class="mono">3,233</span>
          followers, until the account got banned. Studio Maud is the
          sequel.
        </p>
        <div class="voorgeschiedenis-proof">
          <Image
            src={vintedProfielOud}
            alt="Screenshot of the banned Vinted profile @maud.hendrix: 5 stars, 1,881 sales, Ghent, 3,233 followers"
            loading="lazy"
            widths={[380, 600, 900]}
            sizes="(max-width: 680px) 90vw, 340px"
          />
        </div>
      </div>
    </section>

    <!-- BUSINESS -->
    <section class="row wrap">
      <span class="row-label label">Business</span>
      <div class="row-body projects">
        <a
          class="project"
          href="https://www.vinted.be/member/306398525-studiomaud"
          target="_blank"
          rel="noopener"
        >
          <span class="project-status mono">Active</span>
          <h3>Studio Maud</h3>
          <p>
            Data-driven second-hand e-commerce on Vinted: 2,500+
            transactions, 774 orders in 2025 at a 56% gross margin, seller
            rating 4.81/5. Sourcing, pricing, quality control and logistics,
            all handled in-house.
          </p>
          <span class="project-cta mono">View profile →</span>
        </a>
      </div>
    </section>

    <!-- JOURNEY -->
    <section class="row wrap traject">
      <span class="row-label label">Journey</span>
      <div class="row-body">
        <Timeline locale="en" />
      </div>
    </section>

    <!-- CONTACT -->
    <section class="contact">
      <div class="wrap contact-grid">
        <div>
          <span class="label label--on-dark">Contact</span>
          <h2>Let's <em>talk.</em></h2>
          <p>
            Open to internships, student jobs and collaborations around
            reselling, e-commerce or data, and to conversations that bring
            criminology and trade together.
          </p>
          <div class="contact-actions">
            <a class="btn btn--mustard" href="mailto:StudioMaud@outlook.com"
              >Send an email</a
            >
          </div>
        </div>
        <div class="contact-meta">
          <p class="mono"><span>Email</span>StudioMaud@outlook.com</p>
          <p class="mono">
            <span>LinkedIn</span>
            <a href="https://www.linkedin.com/in/maud-hendrix-522245374" target="_blank" rel="noopener"
              >maud-hendrix-522245374</a
            >
          </p>
          <p class="mono"><span>Location</span>Ghent, Belgium</p>
        </div>
      </div>
    </section>
  </main>

  <StickyFooterBar showVat subtitle="Ghent, Belgium" />
</BaseLayout>

<style>
  .pro {
    background: var(--cream);
  }

  /* INTRO */
  .intro {
    border-bottom: 1px solid var(--ink);
    padding-block: clamp(48px, 7vw, 88px);
    position: relative;
  }
  .intro-grid {
    position: relative;
  }
  .block-mark {
    display: none;
  }
  .intro-copy {
    position: relative;
    z-index: 1;
    max-width: 62ch;
  }
  .intro-copy h1 {
    font-size: clamp(36px, 5.5vw, 60px);
    font-weight: 600;
    margin-block: 16px 20px;
    line-height: 1.05;
  }
  .lede {
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 28px;
  }
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* ROWS */
  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 28px;
    padding-block: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--ink);
  }
  .row-label {
    padding-top: 4px;
  }
  .row-body {
    min-width: 0;
  }
  .row-body h2 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .row-body > p {
    font-size: 16px;
    line-height: 1.6;
    max-width: 60ch;
  }

  @media (max-width: 680px) {
    .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  /* EDUCATION */
  .education {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .edu-period {
    display: block;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--mustard-deep);
    margin-bottom: 8px;
  }
  .edu p {
    font-size: 15px;
    opacity: 0.85;
  }

  /* SKILLS */
  .skills-section {
    border-bottom: 1px solid var(--ink);
    padding-block: clamp(36px, 5vw, 56px) 0;
  }
  .skills-head {
    padding-bottom: 20px;
  }

  /* LANGUAGES & TOOLS */
  .langs-tools {
    display: grid;
    grid-template-columns: minmax(200px, 300px) 1fr;
    gap: 44px;
  }
  .langs,
  .tools {
    min-width: 0;
  }
  .subhead {
    display: flex;
    margin-bottom: 18px;
  }

  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .lang-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--ink);
  }
  .lang-name {
    font-size: 17px;
    font-weight: 600;
  }
  .lang-level {
    font-size: 13px;
    color: var(--navy);
    white-space: nowrap;
  }

  @media (max-width: 780px) {
    .langs-tools {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* EXPERIENCE */
  .experience {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .exp-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 20px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: 14px;
  }
  .exp-head h2 {
    font-size: clamp(20px, 2.6vw, 26px);
  }
  .exp-period {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--navy);
    opacity: 0.8;
    white-space: nowrap;
  }
  .exp--closed .exp-period {
    color: var(--rust);
    opacity: 1;
  }
  .exp-context {
    font-size: 15px;
    line-height: 1.6;
    max-width: 62ch;
    margin-bottom: 16px;
  }
  .exp ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 68ch;
  }
  .exp li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.55;
  }
  .exp li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    background: var(--mustard);
  }
  .exp--closed li::before {
    background: var(--rust);
  }

  .inline-link {
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid var(--navy);
  }
  .inline-link:hover {
    color: var(--rust);
    border-color: var(--rust);
  }

  .voorgeschiedenis-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 28px;
  }
  .voorgeschiedenis-body p {
    flex: 1 1 320px;
  }
  .voorgeschiedenis-proof {
    flex: 0 1 340px;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 10px;
    min-width: 0;
  }
  .voorgeschiedenis-proof :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* PROJECTS */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 26px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  a.project:hover {
    transform: translateY(-2px);
    box-shadow: none;
  }
  .project--closed {
    background: transparent;
    opacity: 0.85;
  }
  .project-status {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }
  .project h3 {
    font-size: 21px;
    font-weight: 600;
  }
  .project p {
    font-size: 14px;
    line-height: 1.55;
  }
  .project-cta {
    margin-top: auto;
    font-size: 12px;
    padding-top: 8px;
    color: var(--navy);
  }

  /* CONTACT */
  .contact {
    background: var(--navy);
    color: var(--paper);
    padding-block: clamp(48px, 7vw, 88px);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
  }
  .contact h2 {
    color: var(--paper);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 600;
    margin-block: 14px 16px;
  }
  .contact p {
    font-size: 16px;
    line-height: 1.6;
    max-width: 46ch;
    opacity: 0.92;
    margin-bottom: 26px;
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .contact .btn {
    border-color: var(--paper);
    color: var(--paper);
  }
  .contact .btn:hover {
    background: var(--paper);
    color: var(--navy);
  }
  .contact-meta {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
    border-left: 2px solid rgba(250, 246, 234, 0.35);
    padding-left: 32px;
  }
  .contact-meta p {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14px;
    margin: 0;
  }
  .contact-meta span {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard);
  }
  .contact-meta a {
    text-decoration: none;
    border-bottom: 1px solid rgba(250, 246, 234, 0.5);
    width: fit-content;
  }

  @media (max-width: 680px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .contact-meta {
      border-left: none;
      padding-left: 0;
      border-top: 2px solid rgba(250, 246, 234, 0.35);
      padding-top: 24px;
    }
  }
</style>
