---
import "../styles/global.css";
import PersonSchema from "../components/PersonSchema.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Language } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
  publishedDate?: string;
  noindex?: boolean;
  canonicalPath?: string;
  image?: string;
  locale?: Language;
  // Locale-interne paden (zonder /en-prefix) van de vertaalde tegenhanger
  // van deze pagina. Alleen meegeven op pagina's die effectief een
  // vertaling hebben — /prive laat dit leeg, dan verschijnen er geen
  // hreflang-tags.
  nlPath?: string;
  enPath?: string;
}

const {
  title,
  description = "Maud Hendrix — criminologie, ondernemerschap en patronen in systemen.",
  type = "website",
  publishedDate,
  noindex = false,
  canonicalPath,
  image = "/og-default.png",
  locale = "nl",
  nlPath,
  enPath,
} = Astro.props;

const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const ogLocale = locale === "en" ? "en_US" : "nl_BE";

const hasTranslation = Boolean(nlPath) && Boolean(enPath);
const hreflangAlternates = hasTranslation
  ? [
      { hreflang: "nl", href: new URL(getRelativeLocaleUrl("nl", nlPath!), Astro.site).toString() },
      { hreflang: "en", href: new URL(getRelativeLocaleUrl("en", enPath!), Astro.site).toString() },
      { hreflang: "x-default", href: new URL(getRelativeLocaleUrl("nl", nlPath!), Astro.site).toString() },
    ]
  : [];

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: title,
        description,
        url: canonicalURL.toString(),
        image: ogImageURL.toString(),
        inLanguage: locale,
        author: {
          "@type": "Person",
          name: "Maud Hendrix",
          sameAs: [
            "https://www.linkedin.com/in/maud-hendrix-522245374",
            "https://vinted.be/member/306398525-studiomaud",
          ],
        },
        publisher: {
          "@type": "Person",
          name: "Maud Hendrix",
          url: "https://maud-hendrix.com",
        },
        ...(publishedDate ? { datePublished: publishedDate } : {}),
      }
    : null;
---

<!doctype html>
<html lang={locale}>
  <head>
<!-- Google Tag Manager -->
<script is:inline>
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-PXTHL5MQ');
</script>
<!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {hreflangAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Maud Hendrix" />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}
    <PersonSchema />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,700;0,800;0,900;1,700&family=Fraunces:ital,opsz@1,9..144&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PXTHL5MQ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />
  </body>
</html>
