---
import "../styles/global.css";
import PersonSchema from "../components/PersonSchema.astro";

interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
  publishedDate?: string;
  noindex?: boolean;
  canonicalPath?: string;
  image?: string;
}

const {
  title,
  description = "Maud Hendrix — criminologie, ondernemerschap en patronen in systemen.",
  type = "website",
  publishedDate,
  noindex = false,
  canonicalPath,
  image = "/og-default.png",
} = Astro.props;

const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://maud-hendrix.com/#website",
  url: "https://maud-hendrix.com/",
  name: "Maud Hendrix",
  inLanguage: "nl-BE",
  author: { "@id": "https://maud-hendrix.com/#person" },
  publisher: { "@id": "https://maud-hendrix.com/#person" },
};

const articleSchema =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        "@id": `${canonicalURL.toString()}#article`,
        headline: title,
        description,
        url: canonicalURL.toString(),
        mainEntityOfPage: canonicalURL.toString(),
        image: ogImageURL.toString(),
        inLanguage: "nl-BE",
        author: { "@id": "https://maud-hendrix.com/#person" },
        publisher: { "@id": "https://maud-hendrix.com/#person" },
        ...(publishedDate ? { datePublished: publishedDate } : {}),
      }
    : null;
---

<!doctype html>
<html lang="nl">
  <head>
<!-- Google Tag Manager -->
<script is:inline>
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-PXTHL5MQ');
</script>
<!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Maud Hendrix" />
    <meta property="og:locale" content="nl_BE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
    )}
    <PersonSchema />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,500&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PXTHL5MQ"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />
  </body>
</html>
