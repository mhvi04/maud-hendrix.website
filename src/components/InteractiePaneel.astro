---
// InteractiePaneel.astro
// Idee overgenomen van noho.ink (Energy usage widget), vertaald naar de
// De Stijl-taal van de site: geen tekstkleur die verandert, maar een
// geometrisch vlak (vierkant/cirkel) dat van vorm en kleur wisselt.
//
// Functioneel: zet echte dark mode + reduced-motion classes op <html>,
// bewaart de keuze in localStorage. Staat als compact icoon vast in de
// rechterbovenhoek en vouwt open bij klik.
---

<div class="interactie-paneel" data-panel>
  <button
    class="paneel-icon"
    data-toggle-panel
    aria-expanded="false"
    aria-controls="paneel-dropdown"
    aria-label="Weergave-instellingen"
    data-status
    data-level="hoog"
  >
    <span class="status-vorm" data-shape></span>
  </button>

  <div class="paneel-dropdown" id="paneel-dropdown" data-panel-body hidden>
    <div class="paneel-dropdown-header">
      <span class="paneel-titel">Weergave</span>
      <span class="status-label" data-label>Hoog</span>
    </div>

    <div class="toggle-rij">
      <div class="toggle-tekst">
        <p class="toggle-naam">Donkere modus</p>
        <p class="toggle-omschrijving">Minder licht op het scherm.</p>
      </div>
      <button
        class="toggle-knop"
        data-toggle="dark"
        role="switch"
        aria-checked="false"
        aria-label="Donkere modus"
      >
        <span class="toggle-bol"></span>
      </button>
    </div>

    <div class="toggle-rij">
      <div class="toggle-tekst">
        <p class="toggle-naam">Verminder animatie</p>
        <p class="toggle-omschrijving">Minder beweging, rustiger ervaring.</p>
      </div>
      <button
        class="toggle-knop"
        data-toggle="motion"
        role="switch"
        aria-checked="false"
        aria-label="Verminder animatie"
      >
        <span class="toggle-bol"></span>
      </button>
    </div>
  </div>
</div>

<style>
  .interactie-paneel {
    position: fixed;
    top: clamp(14px, 3vw, 24px);
    right: clamp(14px, 3vw, 24px);
    z-index: 60;
  }

  .paneel-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 2px solid var(--navy);
    background: var(--cream);
    padding: 0;
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .paneel-icon:hover,
  .paneel-icon:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .paneel-icon:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .paneel-icon[aria-expanded="true"] {
    background: var(--navy);
  }

  .status-vorm {
    width: 12px;
    height: 12px;
    transition: background 0.2s ease, border-radius 0.2s ease;
  }

  /* drie toestanden = drie vormen/kleuren, geen gradient */
  .paneel-icon[data-level="hoog"] .status-vorm {
    background: var(--mustard);
    border-radius: 0;
  }
  .paneel-icon[data-level="gemiddeld"] .status-vorm {
    background: var(--mustard);
    border-radius: 50%;
  }
  .paneel-icon[data-level="laag"] .status-vorm {
    background: var(--navy);
    border-radius: 50%;
  }
  .paneel-icon[aria-expanded="true"][data-level="laag"] .status-vorm {
    background: var(--cream);
  }

  .paneel-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: min(300px, calc(100vw - 28px));
    background: var(--cream);
    border: 2px solid var(--navy);
    box-shadow: 6px 6px 0 var(--ink);
    padding: 1rem 1.25rem 1.1rem;
  }

  .paneel-dropdown-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(28, 43, 74, 0.2);
  }

  .paneel-titel {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--navy);
  }

  .status-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--navy);
  }

  .toggle-rij {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0;
  }

  .toggle-rij + .toggle-rij {
    border-top: 1px solid rgba(28, 43, 74, 0.2);
  }

  .toggle-naam {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--navy);
    margin: 0;
  }

  .toggle-omschrijving {
    font-size: 0.75rem;
    color: rgba(28, 43, 74, 0.65);
    margin: 0.2rem 0 0;
  }

  .toggle-knop {
    flex-shrink: 0;
    width: 44px;
    height: 24px;
    background: rgba(28, 43, 74, 0.15);
    border: 2px solid var(--navy);
    padding: 2px;
    cursor: pointer;
  }

  .toggle-bol {
    display: block;
    width: 16px;
    height: 16px;
    background: var(--cream);
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .toggle-knop[aria-checked="true"] .toggle-bol {
    transform: translateX(20px);
    background: var(--mustard);
  }
</style>

<script>
  const paneel = document.querySelector<HTMLDivElement>("[data-panel]");

  if (paneel) {
    const panelToggle = paneel.querySelector<HTMLButtonElement>("[data-toggle-panel]");
    const panelBody = paneel.querySelector<HTMLDivElement>("[data-panel-body]");
    const statusLabel = paneel.querySelector<HTMLSpanElement>("[data-label]");
    const darkToggle = paneel.querySelector<HTMLButtonElement>('[data-toggle="dark"]');
    const motionToggle = paneel.querySelector<HTMLButtonElement>('[data-toggle="motion"]');

    function closePanel() {
      panelToggle?.setAttribute("aria-expanded", "false");
      if (panelBody) panelBody.hidden = true;
    }

    panelToggle?.addEventListener("click", () => {
      const isOpen = panelToggle.getAttribute("aria-expanded") === "true";
      const nextOpen = !isOpen;
      panelToggle.setAttribute("aria-expanded", String(nextOpen));
      if (panelBody) panelBody.hidden = !nextOpen;
    });

    document.addEventListener("click", (event) => {
      if (!paneel.contains(event.target as Node)) closePanel();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closePanel();
    });

    function updateStatus() {
      const dark = darkToggle?.getAttribute("aria-checked") === "true";
      const motion = motionToggle?.getAttribute("aria-checked") === "true";

      let niveau = "hoog";
      let label = "Hoog";
      if (dark && motion) {
        niveau = "laag";
        label = "Laag";
      } else if (dark || motion) {
        niveau = "gemiddeld";
        label = "Gemiddeld";
      }

      panelToggle?.setAttribute("data-level", niveau);
      if (statusLabel) statusLabel.textContent = label;
    }

    function bindToggle(toggle: HTMLButtonElement | null, key: "dark" | "motion", cssClass: string) {
      if (!toggle) return;
      toggle.addEventListener("click", (event) => {
        event.stopPropagation();
        const isChecked = toggle.getAttribute("aria-checked") === "true";
        const nextChecked = !isChecked;
        toggle.setAttribute("aria-checked", String(nextChecked));
        document.documentElement.classList.toggle(cssClass, nextChecked);
        localStorage.setItem(key, String(nextChecked));
        updateStatus();
      });
    }

    bindToggle(darkToggle, "dark", "dark-mode");
    bindToggle(motionToggle, "motion", "reduce-motion");

    // init vanuit localStorage
    const savedDark = localStorage.getItem("dark") === "true";
    const savedMotion = localStorage.getItem("motion") === "true";
    if (savedDark) darkToggle?.setAttribute("aria-checked", "true");
    if (savedMotion) motionToggle?.setAttribute("aria-checked", "true");
    document.documentElement.classList.toggle("dark-mode", savedDark);
    document.documentElement.classList.toggle("reduce-motion", savedMotion);
    updateStatus();
  }
</script>
