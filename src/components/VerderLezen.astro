---
interface RelatedArticle {
  href: string;
  tag: string;
  title: string;
  excerpt: string;
}

interface Props {
  articles: RelatedArticle[];
  locale?: "nl" | "en";
}

const { articles, locale = "nl" } = Astro.props;
const heading = locale === "en" ? "Keep reading" : "Verder lezen";
---

{
  articles.length > 0 && (
    <section class="verder-lezen">
      <h2 class="heading mono">{heading}</h2>
      <div class="grid">
        {articles.map((a) => (
          <a href={a.href} class="card">
            <span class="card-tag mono">{a.tag}</span>
            <h3>{a.title}</h3>
            <p>{a.excerpt}</p>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .verder-lezen {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--ink);
  }
  .heading {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
    margin-bottom: 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 22px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    background: var(--cream);
  }
  .card-tag {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }
  .card h3 {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }
  .card p {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
    opacity: 0.85;
  }
</style>
