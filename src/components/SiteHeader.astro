---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Language } from "../i18n/ui";
import LanguageSwitch from "./LanguageSwitch.astro";

type World = "pro" | "prive" | "artikelen";

interface Props {
  world: World;
  locale?: Language;
  nlPath?: string;
  enPath?: string;
}
const { world, locale = "nl", nlPath, enPath } = Astro.props;

const worlds: Record<World, { href: string; label: string; accent: string }> = {
  pro: { href: "/professioneel", label: "Professioneel", accent: "var(--mustard)" },
  prive: { href: "/prive", label: "Privé", accent: "var(--periwinkle)" },
  artikelen: { href: "/artikelen", label: "Artikelen", accent: "var(--navy)" },
};
const others = (Object.keys(worlds) as World[]).filter((w) => w !== world);
const accent = worlds[world].accent;

// De Professioneel/Privé/Artikelen-switcher bestaat alleen in het NL-domein
// (geen Engelse /prive). De taalwissel wordt alleen getoond als de pagina
// zijn vertaalde tegenhanger meegeeft, en nooit op /prive.
const showWorldSwitch = locale === "nl";
const showLanguageSwitch = Boolean(nlPath) && Boolean(enPath);
const homeHref = getRelativeLocaleUrl(locale, "/");
const t = useTranslations(locale).nav;
---

<header class="site-header">
  <div class="wrap bar">
    <a href={homeHref} class="mark">
      <span class="mark-block" style={`background:${accent}`}></span>
      Maud Hendrix
    </a>
    <nav class="links">
      <a href={homeHref} class="home-link">{t.home}</a>
      {showWorldSwitch && others.map((w) => (
        <a href={worlds[w].href} class="switch">
          {worlds[w].label} <span aria-hidden="true">→</span>
        </a>
      ))}
      {showLanguageSwitch && (
        <LanguageSwitch locale={locale} nlPath={nlPath!} enPath={enPath!} />
      )}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--ink);
    background: var(--cream);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 18px;
  }
  .mark {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    text-decoration: none;
    color: var(--ink);
  }
  .mark-block {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
  }
  .links a {
    text-decoration: none;
  }
  .home-link {
    color: var(--navy);
    opacity: 0.75;
  }
  .home-link:hover {
    opacity: 1;
  }
  .switch {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 3px;
    font-weight: 500;
  }
  .switch:hover {
    color: var(--navy);
    border-color: var(--navy);
  }

  @media (max-width: 560px) {
    .links {
      gap: 16px;
      font-size: 12px;
    }
    .home-link {
      display: none;
    }
  }
</style>
