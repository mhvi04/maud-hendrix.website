---
const books = [
  { title: "The Boy, the Mole, the Fox and the Horse", author: "Charlie Mackesy", rating: 5, dateRead: "2025-06-08" },
  { title: "Gedichten", author: "Hugo Claus", rating: 4.3, dateRead: "2025-07-02" },
  { title: "1984", author: "George Orwell", rating: 4.9, dateRead: "2025-07-28" },
  { title: "V for Vendetta", author: "Alan Moore & David Lloyd", rating: 4.5, dateRead: "2025-08-20" },
  { title: "Godverdomse dagen op een godverdomse bol", author: "Dimitri Verhulst", rating: 4.1, dateRead: "2025-09-10" },
  { title: "Rechts voor de raap", author: "Jean-Marie Dedecker", rating: 3.4, dateRead: "2025-09-25" },
  { title: "Vrouwen in opstand", author: "Lloyd", rating: 3.8, dateRead: "2025-10-02" },
  { title: "Fire*", author: "Charlotte Van Brabander", rating: 4, dateRead: "2025-10-20" },
  { title: "Vele hemels boven de zevende", author: "Griet Op de Beeck", rating: 4.8, dateRead: "2025-11-02" },
  { title: "Het parfum", author: "Patrick Süskind", rating: 4, dateRead: "2025-11-20" },
  { title: "Christiane F.", author: "Christiane F.", rating: 4.7, dateRead: "2025-12-05" },
  { title: "Een schitterend gebrek", author: "Arthur Japin", rating: 4.2, dateRead: "2025-12-22" },
  { title: "Dossier Dutroux, de waarheid", author: "Jean Lambrecks, Els Schreurs & Jean-Pierre Adam", rating: 3.2, dateRead: "2026-01-15" },
  { title: "Batman", author: "Frank Miller & David Mazzucchelli", rating: 4, dateRead: "2026-03-15" },
  { title: "Het einde van de mensheid in 1967", author: "Herman Brusselmans", rating: 3.5, dateRead: "2026-04-15" },
];

const shelf = [...books].reverse();

function prettyDate(date: string) {
  return new Intl.DateTimeFormat("nl-BE", { month: "long", year: "numeric" }).format(new Date(date + "T12:00:00"));
}
---

<div class="bookshelf" data-bookshelf>
  <div class="shelf-head">
    <div>
      <p class="shelf-kicker mono">Mijn boekenkast</p>
      <p class="shelf-intro">Geen recensies. Gewoon wat ik gelezen heb en wat ervan is blijven hangen.</p>
    </div>
    <p class="shelf-count mono">{books.length} boeken</p>
  </div>

  <div class="shelf-stage">
    <div class="books" role="list" aria-label="Gelezen boeken">
      {shelf.map((book, i) => (
        <button
          class={"book c" + ((i % 5) + 1)}
          type="button"
          role="listitem"
          data-book
          data-title={book.title}
          data-author={book.author}
          data-rating={book.rating}
          data-date={prettyDate(book.dateRead)}
          aria-label={book.title + " van " + book.author}
          aria-expanded="false"
        >
          <span class="spine-title">{book.title}</span>
          <span class="spine-author">{book.author}</span>
        </button>
      ))}
    </div>
    <div class="shelf-board" aria-hidden="true"></div>
  </div>

  <aside class="book-detail" data-detail hidden aria-live="polite">
    <button class="detail-close" type="button" data-close aria-label="Sluit boekdetails">×</button>
    <span class="detail-label mono">Uit de kast</span>
    <h3 data-detail-title></h3>
    <p class="detail-author" data-detail-author></p>
    <div class="detail-meta">
      <span class="mono" data-detail-date></span>
      <span class="rating"><strong data-detail-rating></strong><span>/ 5</span></span>
    </div>
    <p class="detail-note">Mijn korte notitie bij dit boek komt hier later.</p>
  </aside>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>("[data-bookshelf]");
  roots.forEach((root) => {
    const detail = root.querySelector<HTMLElement>("[data-detail]");
    const title = root.querySelector<HTMLElement>("[data-detail-title]");
    const author = root.querySelector<HTMLElement>("[data-detail-author]");
    const date = root.querySelector<HTMLElement>("[data-detail-date]");
    const rating = root.querySelector<HTMLElement>("[data-detail-rating]");
    const close = root.querySelector<HTMLButtonElement>("[data-close]");
    const books = root.querySelectorAll<HTMLButtonElement>("[data-book]");

    const shut = () => {
      if (!detail) return;
      detail.hidden = true;
      books.forEach((book) => book.setAttribute("aria-expanded", "false"));
    };

    books.forEach((book) => {
      book.addEventListener("click", () => {
        if (!detail || !title || !author || !date || !rating) return;
        const wasOpen = book.getAttribute("aria-expanded") === "true";
        books.forEach((item) => item.setAttribute("aria-expanded", "false"));
        if (wasOpen) return shut();
        title.textContent = book.dataset.title ?? "";
        author.textContent = book.dataset.author ?? "";
        date.textContent = book.dataset.date ?? "";
        rating.textContent = (Number(book.dataset.rating ?? 0)).toFixed(1).replace(".", ",");
        book.setAttribute("aria-expanded", "true");
        detail.hidden = false;
      });
    });

    close?.addEventListener("click", shut);
    root.addEventListener("keydown", (event) => {
      if (event.key === "Escape") shut();
    });
  });
</script>

<style>
  .bookshelf { position: relative; }
  .shelf-head {
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 24px; margin-bottom: 28px;
  }
  .shelf-kicker { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--mustard-deep); margin: 0 0 7px; }
  .shelf-intro { max-width: 48ch; margin: 0; font-size: 15px; line-height: 1.55; }
  .shelf-count { margin: 0; font-size: 12px; white-space: nowrap; color: var(--navy); }
  .shelf-stage { overflow-x: auto; padding: 18px 6px 0; scrollbar-width: thin; }
  .books { min-width: max-content; height: 300px; display: flex; align-items: flex-end; gap: 5px; padding-inline: 8px; }
  .book {
    --w: 54px; width: var(--w); height: 245px; border: 1px solid var(--ink); border-bottom: 0;
    padding: 15px 8px 12px; display: flex; flex-direction: column; justify-content: space-between;
    align-items: center; cursor: pointer; color: var(--ink); transform-origin: bottom center;
    transition: transform .18s ease, filter .18s ease, box-shadow .18s ease;
  }
  .book:nth-child(3n) { height: 275px; --w: 61px; }
  .book:nth-child(4n) { height: 225px; --w: 48px; }
  .book:nth-child(7n) { height: 260px; --w: 67px; }
  .book:hover, .book:focus-visible, .book[aria-expanded="true"] {
    transform: translateY(-14px) rotate(-1deg); z-index: 2; filter: brightness(1.04);
    box-shadow: none; outline: none;
  }
  .spine-title, .spine-author { writing-mode: vertical-rl; transform: rotate(180deg); }
  .spine-title { font-family: var(--font-display); font-size: 14px; font-weight: 650; line-height: 1.05; max-height: 175px; overflow: hidden; }
  .spine-author { font-family: var(--font-mono); font-size: 8px; line-height: 1.1; max-height: 92px; overflow: hidden; }
  .c1 { background: var(--navy); color: var(--cream); }
  .c2 { background: var(--mustard); }
  .c3 { background: var(--periwinkle); color: var(--ink); }
  .c4 { background: var(--mustard-deep); color: var(--cream); }
  .c5 { background: var(--paper); }
  .shelf-board { min-width: 860px; height: 16px; border: 1px solid var(--ink); background: var(--mustard); box-shadow: none; }

  .book-detail {
    position: relative; margin-top: 30px; border: 1px solid var(--ink); background: var(--paper);
    padding: clamp(24px, 4vw, 38px); box-shadow: none;
  }
  .book-detail[hidden] { display: none; }
  .detail-close {
    position: absolute; right: 14px; top: 10px; width: 36px; height: 36px; border: 0;
    background: transparent; font-size: 28px; cursor: pointer; color: var(--ink);
  }
  .detail-label { display: block; margin-bottom: 12px; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--mustard-deep); }
  .book-detail h3 { max-width: 18ch; margin: 0; font-size: clamp(26px, 4vw, 42px); line-height: 1.05; }
  .detail-author { margin: 10px 0 24px; font-family: var(--font-mono); font-size: 13px; }
  .detail-meta { display: flex; gap: 18px; align-items: center; padding-top: 16px; border-top: 1px solid var(--ink); }
  .rating { margin-left: auto; font-family: var(--font-mono); font-size: 12px; }
  .rating strong { font-family: var(--font-display); font-size: 28px; margin-right: 3px; }
  .detail-note { margin: 24px 0 0; font-size: 14px; font-style: italic; opacity: .7; }

  @media (max-width: 600px) {
    .shelf-head { align-items: flex-start; flex-direction: column; gap: 10px; }
    .books { height: 260px; }
    .book { height: 215px; --w: 48px; }
    .book:nth-child(3n) { height: 240px; --w: 53px; }
    .book:nth-child(4n) { height: 198px; --w: 43px; }
    .book:nth-child(7n) { height: 230px; --w: 58px; }
    .spine-title { font-size: 12px; max-height: 150px; }
    .shelf-board { min-width: 760px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .book { transition: none; }
    .book:hover, .book:focus-visible, .book[aria-expanded="true"] { transform: none; }
  }
</style>
