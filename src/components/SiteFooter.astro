---
import PatternStrip from "./PatternStrip.astro";

interface Props {
  world?: "pro" | "prive";
}
const { world = "pro" } = Astro.props;
---

<footer class="site-footer">
  <PatternStrip />
  <div class="wrap bottom">
    <p class="mono small">
      © {new Date().getFullYear()} Maud Hendrix
      {world === "pro" && <span class="ond"> · BE 1019.593.031</span>}
    </p>
    <p class="mono small">Gent, België</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--paper);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    padding-block: 22px 28px;
  }
  .small {
    font-size: 12px;
    color: var(--navy);
    opacity: 0.75;
    letter-spacing: 0.02em;
  }
  .ond {
    opacity: 0.7;
  }
</style>
