---
// SiteFooter.astro
// Donkere afsluiter op elke pagina. Het contactanker (#contact) uit het menu
// wijst hierheen. "Beweging uitzetten" gebruikt dezelfde opslag als het
// bestaande InteractiePaneel (localStorage-sleutel "motion", klasse
// html.reduce-motion), dus beide blijven in sync.
import { useTranslations, type Language } from "../i18n/ui";

interface Props {
  locale?: Language;
  // Blijven bestaan zodat pagina's niets hoeven te wijzigen; niet meer gebruikt.
  showVat?: boolean;
  subtitle?: string;
}
const { locale = "nl" } = Astro.props;
const t = useTranslations(locale).footer;
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="inner">
    <p class="kicker">{t.kicker}</p>
    <a class="cta" href="mailto:StudioMaud@outlook.com">
      <span class="cta-text">{t.cta}</span>
      <svg class="arrow" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <path d="M6 34L34 6M12 6h22v22" stroke="currentColor" stroke-width="2.4" />
      </svg>
    </a>

    <div class="legal">
      <p>Maud Hendrix © {year}</p>
      <p>{t.location} · BE 1019.593.031</p>
      <a
        class="ext"
        href="https://www.linkedin.com/in/maud-hendrix-522245374"
        target="_blank"
        rel="noopener"
      >{t.linkedin} <span aria-hidden="true">↗</span></a>
      <button
        type="button"
        class="motion"
        id="motion-toggle"
        aria-pressed="false"
        data-off={t.motionOff}
        data-on={t.motionOn}
      >{t.motionOff}</button>
    </div>
  </div>
</footer>

<script>
  const btn = document.getElementById("motion-toggle") as HTMLButtonElement | null;
  const root = document.documentElement;

  function paint() {
    if (!btn) return;
    const reduced = root.classList.contains("reduce-motion");
    btn.setAttribute("aria-pressed", String(reduced));
    btn.textContent = reduced ? btn.dataset.on ?? "" : btn.dataset.off ?? "";
  }

  btn?.addEventListener("click", () => {
    const next = !root.classList.contains("reduce-motion");
    root.classList.toggle("reduce-motion", next);
    try {
      localStorage.setItem("motion", String(next));
    } catch {
      /* opslag niet beschikbaar: de keuze geldt dan alleen op deze pagina */
    }
    paint();
  });

  paint();
</script>

<style>
  .site-footer {
    background: var(--footer-bg);
    color: var(--footer-ink);
    padding: clamp(56px, 9vw, 120px) clamp(20px, 3vw, 40px) 32px;
  }
  .inner {
    max-width: 1500px;
    margin: 0 auto;
  }
  .kicker {
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.35;
    max-width: 14em;
    margin-bottom: clamp(40px, 7vw, 88px);
  }
  .cta {
    display: inline-flex;
    align-items: flex-end;
    gap: clamp(16px, 3vw, 40px);
    color: inherit;
    text-decoration: none;
    padding-bottom: 6px;
    border-bottom: 2px solid currentColor;
    max-width: 100%;
  }
  .cta-text {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 11vw, 9rem);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .arrow {
    width: clamp(28px, 4vw, 52px);
    height: clamp(28px, 4vw, 52px);
    flex: 0 0 auto;
    margin-bottom: clamp(8px, 1.6vw, 22px);
    transition: transform 0.25s ease;
  }
  .cta:hover .arrow,
  .cta:focus-visible .arrow {
    transform: translate(6px, -6px);
  }
  .cta:focus-visible,
  .ext:focus-visible,
  .motion:focus-visible {
    outline: 2px solid var(--footer-ink);
    outline-offset: 6px;
  }

  .legal {
    margin-top: clamp(48px, 8vw, 96px);
    padding-top: 28px;
    border-top: 1px solid rgba(238, 235, 227, 0.3);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 24px;
    font-size: 13px;
  }
  .legal p,
  .legal a,
  .legal button {
    margin: 0;
  }
  .ext {
    color: inherit;
    text-decoration: none;
    justify-self: start;
  }
  .ext:hover {
    text-decoration: underline;
  }
  .motion {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font-size: 13px;
    justify-self: start;
  }
  .motion:hover {
    text-decoration: underline;
  }

  @media (min-width: 900px) {
    .legal {
      grid-template-columns: 1fr 1fr;
      max-width: 62%;
    }
  }
</style>
