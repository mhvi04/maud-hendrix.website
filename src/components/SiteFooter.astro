---
interface Props {
  world?: "pro" | "prive";
}
const { world = "pro" } = Astro.props;
---

<footer class="site-footer">
  <div class="tick-row" aria-hidden="true">
    {
      Array.from({ length: 18 }).map((_, i) => (
        <span class={`tick tick-${i % 4}`} />
      ))
    }
  </div>
  <div class="wrap bottom">
    <p class="mono small">
      © {new Date().getFullYear()} Maud Hendrix
      {world === "pro" && <span class="ond"> · BE 1019.593.031</span>}
    </p>
    <p class="mono small">Gent, België</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 3px solid var(--ink);
    background: var(--paper);
  }
  .tick-row {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    padding: 22px clamp(20px, 5vw, 56px) 0;
    overflow: hidden;
  }
  .tick {
    flex: 0 0 auto;
    display: block;
  }
  .tick-0 {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--navy);
  }
  .tick-1 {
    width: 2px;
    height: 20px;
    background: var(--mustard);
  }
  .tick-2 {
    width: 8px;
    height: 8px;
    background: var(--rust);
  }
  .tick-3 {
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 11px solid var(--navy);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    padding-block: 22px 28px;
  }
  .small {
    font-size: 12px;
    color: var(--navy);
    opacity: 0.75;
    letter-spacing: 0.02em;
  }
  .ond {
    opacity: 0.7;
  }
</style>
