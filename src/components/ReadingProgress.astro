---
// ReadingProgress.astro
// Dunne balk bovenaan die meeloopt met het lezen van het artikel.
// Meet de voortgang over het element met data-reading-body.
---

<div class="rp" aria-hidden="true"><div class="rp-bar" data-rp-bar></div></div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-rp-bar]");
  const body = document.querySelector<HTMLElement>("[data-reading-body]");
  let ticking = false;

  function update() {
    ticking = false;
    if (!bar || !body) return;
    const rect = body.getBoundingClientRect();
    const total = rect.height - window.innerHeight * 0.6;
    const done = window.innerHeight * 0.2 - rect.top;
    const p = total > 0 ? Math.min(1, Math.max(0, done / total)) : 0;
    bar.style.transform = `scaleX(${p.toFixed(4)})`;
  }
  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  update();
</script>

<style>
  .rp {
    position: fixed;
    inset: 0 0 auto 0;
    height: 4px;
    z-index: 120;
    pointer-events: none;
  }
  .rp-bar {
    height: 100%;
    background: var(--rust);
    transform-origin: left;
    transform: scaleX(0);
  }
</style>
