const edges: [string, string][] = [
  ["patronen", "criminologie"],
  ["patronen", "data"],
  ["patronen", "systemen"],
  ["patronen", "onderzoek"],
  ["patronen", "ondernemen"],
  ["patronen", "design"],

  ["criminologie", "gedrag"],
  ["criminologie", "bachelorproef"],
  ["criminologie", "digitalisering"],
  ["criminologie", "onderzoek"],

  ["data", "analyse"],
  ["data", "visualisatie"],
  ["data", "vinted"],
  ["data", "pricing"],
  ["data", "studiomaud"],

  ["ondernemen", "vintiebulk"],
  ["ondernemen", "vinted"],
  ["ondernemen", "ecommerce"],
  ["ondernemen", "pricing"],
  ["ondernemen", "studiomaud"],

  ["design", "ux"],
  ["design", "web"],
  ["design", "learningcenter"],

  ["systemen", "technologie"],
  ["systemen", "digitalisering"],
  ["systemen", "learningcenter"],

  ["vinted", "vintiebulk"],
  ["vinted", "pricing"],
  ["vinted", "marktplaatsen"],

  ["vintiebulk", "data"],
  ["vintiebulk", "ecommerce"],

  ["onderzoek", "analyse"],
];

const relatedMap = new Map<string, string[]>();
for (const n of nodes) relatedMap.set(n.id, []);
for (const [a, b] of edges) {
  relatedMap.get(a)?.push(b);
  relatedMap.get(b)?.push(a);
}

---

<div class="brain" id="brain-network">
  <div class="brain-canvas" id="brain-canvas">
    <svg class="brain-edges" aria-hidden="true" focusable="false">
      {
        edges.map(([a, b]) => (
          <line class="edge" data-a={a} data-b={b} x1="0" y1="0" x2="0" y2="0" />
        ))
      }
    </svg>

    <div class="brain-nodes">
      {
        nodes.map((n) => (
          <button
            type="button"
            class={`node node--${n.type}`}
            data-id={n.id}
            data-related={(relatedMap.get(n.id) ?? []).join(",")}
            style={`--x:${n.pos.x};--y:${n.pos.y};--mx:${n.posMobile.x};--my:${n.posMobile.y};`}
            aria-describedby="brain-panel"
          >
            <span class="node-shape" aria-hidden="true" />
            <span class="node-label">{n.label}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="brain-panel" id="brain-panel" aria-live="polite">
    <div class="brain-panel-empty" id="brain-panel-empty">
      <span class="mono">Selecteer een knoop</span>
      <p>Klik of tik op een van de knopen om te lezen hoe die past in het geheel.</p>
    </div>
    <div class="brain-panel-content" id="brain-panel-content" hidden>
      <span class="mono brain-panel-tag" id="brain-panel-tag"></span>
      <h2 id="brain-panel-title"></h2>
      <p id="brain-panel-desc"></p>
      <div class="brain-panel-related">
        <span class="mono brain-panel-related-label">Gerelateerd</span>
        <div class="brain-panel-tags" id="brain-panel-tags"></div>
      </div>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{ nodesData: nodes.map((n) => ({ id: n.id, label: n.label, type: n.type, desc: n.desc })) }}
>
  const canvas = document.getElementById("brain-canvas");
  const svg = canvas?.querySelector(".brain-edges");
  const nodeEls = Array.from(canvas?.querySelectorAll(".node") ?? []);
  const edgeEls = Array.from(svg?.querySelectorAll(".edge") ?? []);
  const panelEmpty = document.getElementById("brain-panel-empty");
  const panelContent = document.getElementById("brain-panel-content");
  const panelTag = document.getElementById("brain-panel-tag");
  const panelTitle = document.getElementById("brain-panel-title");
  const panelDesc = document.getElementById("brain-panel-desc");
  const panelTags = document.getElementById("brain-panel-tags");

  const dataById = new Map(nodesData.map((n) => [n.id, n]));
  const typeLabels = {
    center: "Kernconcept",
    core: "Kernconcept",
    secondary: "Verwant concept",
    project: "Project",
  };

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canHover = window.matchMedia("(pointer: fine)").matches;

  let pinnedId = null;

  function measureAndDraw() {
    if (!canvas) return;
    const canvasRect = canvas.getBoundingClientRect();
    const centers = new Map();
    nodeEls.forEach((el) => {
      const r = el.getBoundingClientRect();
      centers.set(el.dataset.id, {
        x: r.left + r.width / 2 - canvasRect.left,
        y: r.top + r.height / 2 - canvasRect.top,
      });
    });
    edgeEls.forEach((line) => {
      const a = centers.get(line.dataset.a);
      const b = centers.get(line.dataset.b);
      if (!a || !b) return;
      line.setAttribute("x1", String(a.x));
      line.setAttribute("y1", String(a.y));
      line.setAttribute("x2", String(b.x));
      line.setAttribute("y2", String(b.y));
    });
  }

  function setActive(id) {
    nodeEls.forEach((el) => {
      const isActive = el.dataset.id === id;
      const related = dataById.has(id) ? (id ? (relatedOf(id) || []) : []) : [];
      el.classList.toggle("is-active", isActive);
      el.classList.toggle("is-related", !isActive && related.includes(el.dataset.id));
      el.classList.toggle("is-dimmed", Boolean(id) && !isActive && !related.includes(el.dataset.id));
    });
    edgeEls.forEach((line) => {
      const lit = id !== null && (line.dataset.a === id || line.dataset.b === id);
      line.classList.toggle("is-lit", lit);
      line.classList.toggle("is-dimmed", Boolean(id) && !lit);
    });
  }

  function relatedOf(id) {
    const el = nodeEls.find((n) => n.dataset.id === id);
    return el ? el.dataset.related.split(",").filter(Boolean) : [];
  }

  function clearActive() {
    if (pinnedId) {
      setActive(pinnedId);
    } else {
      setActive(null);
    }
  }

  function openPanel(id) {
    const data = dataById.get(id);
    if (!data) return;
    panelEmpty.hidden = true;
    panelContent.hidden = false;
    panelTag.textContent = typeLabels[data.type] ?? "";
    panelTitle.textContent = data.label;
    panelDesc.textContent = data.desc;
    panelTags.innerHTML = "";
    relatedOf(id).forEach((relId) => {
      const relData = dataById.get(relId);
      if (!relData) return;
      const tag = document.createElement("button");
      tag.type = "button";
      tag.className = "brain-tag";
      tag.textContent = relData.label;
      tag.addEventListener("click", () => activate(relId));
      panelTags.appendChild(tag);
    });
  }

  function activate(id) {
    pinnedId = id;
    setActive(id);
    openPanel(id);
  }

  nodeEls.forEach((el) => {
    const id = el.dataset.id;
    el.addEventListener("mouseenter", () => {
      if (!canHover) return;
      setActive(id);
    });
    el.addEventListener("mouseleave", () => {
      if (!canHover) return;
      clearActive();
    });
    el.addEventListener("focus", () => setActive(id));
    el.addEventListener("blur", () => clearActive());
    el.addEventListener("click", () => activate(id));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && pinnedId) {
      pinnedId = null;
      setActive(null);
      panelEmpty.hidden = false;
      panelContent.hidden = true;
    }
  });

  let resizeTimer;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(measureAndDraw, 120);
  });

  requestAnimationFrame(() => {
    measureAndDraw();
    setTimeout(measureAndDraw, 200);
    setTimeout(measureAndDraw, 600);
  });

  if (document.fonts?.ready) {
    document.fonts.ready.then(measureAndDraw);
  }

  if (!prefersReducedMotion) {
    canvas?.classList.add("brain-js");
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        canvas?.classList.add("is-loaded");
      });
    });

    if (canHover) {
      canvas?.addEventListener("pointermove", (e) => {
        const rect = canvas.getBoundingClientRect();
        const relX = (e.clientX - rect.left) / rect.width - 0.5;
        const relY = (e.clientY - rect.top) / rect.height - 0.5;
        const max = 7;
        canvas.style.setProperty("--parallax-x", `${(-relX * max).toFixed(2)}px`);
        canvas.style.setProperty("--parallax-y", `${(-relY * max).toFixed(2)}px`);
      });
      canvas?.addEventListener("pointerleave", () => {
        canvas.style.setProperty("--parallax-x", "0px");
        canvas.style.setProperty("--parallax-y", "0px");
      });
    }
  }
</script>

<style>
  .brain {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 40px);
  }

  .brain-canvas {
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 480px;
    border: 3px solid var(--ink);
    background: var(--paper);
    overflow: hidden;
  }

  @media (max-width: 720px) {
    .brain-canvas {
      aspect-ratio: auto;
      height: 760px;
      min-height: 0;
    }
  }

  .brain-nodes,
  .brain-edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .brain-nodes {
    transform: translate(var(--parallax-x, 0px), var(--parallax-y, 0px));
    transition: transform 0.4s ease-out;
  }

  .brain-edges .edge {
    stroke: var(--navy);
    stroke-width: 1.2;
    opacity: 0.28;
    transition: opacity 0.25s ease, stroke-width 0.25s ease, stroke 0.25s ease;
  }
  .brain-edges .edge.is-lit {
    stroke: var(--mustard-deep);
    stroke-width: 2;
    opacity: 0.95;
  }
  .brain-edges .edge.is-dimmed {
    opacity: 0.08;
  }

  .node {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    border: none;
    background: none;
    padding: 6px;
    cursor: pointer;
    font-family: var(--font-body);
    transition: opacity 0.3s ease, filter 0.3s ease;
  }

  @media (max-width: 720px) {
    .node {
      left: calc(var(--mx) * 1%);
      top: calc(var(--my) * 1%);
    }
  }

  .node:focus-visible {
    outline: none;
  }
  .node:focus-visible .node-shape {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }

  .node.is-dimmed {
    opacity: 0.28;
  }
  .node.is-active .node-shape,
  .node.is-related .node-shape {
    filter: none;
  }

  .node-shape {
    display: block;
    background: var(--mustard);
    border: 3px solid var(--ink);
    border-radius: 50%;
  }
  .node-label {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
    color: var(--ink);
    white-space: nowrap;
  }

  /* CENTER */
  .node--center .node-shape {
    width: 96px;
    height: 96px;
    background: var(--navy);
  }
  .node--center .node-label {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 600;
    color: var(--navy);
  }
  @media (max-width: 720px) {
    .node--center .node-shape {
      width: 68px;
      height: 68px;
    }
  }

  /* CORE */
  .node--core .node-shape {
    width: 56px;
    height: 56px;
  }
  .node--core .node-label {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .node--core .node-shape {
      width: 44px;
      height: 44px;
    }
  }

  /* SECONDARY */
  .node--secondary .node-shape {
    width: 26px;
    height: 26px;
    background: var(--paper);
    border-width: 2px;
    border-color: var(--navy);
  }
  .node--secondary .node-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--navy);
    opacity: 0.85;
  }
  @media (max-width: 720px) {
    .node--secondary .node-shape {
      width: 20px;
      height: 20px;
    }
  }

  /* PROJECT */
  .node--project .node-shape {
    width: 22px;
    height: 22px;
    border-radius: 3px;
    background: var(--rust);
    transform: rotate(45deg);
  }
  .node--project .node-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--rust);
    letter-spacing: 0.02em;
  }

  /* ENTRANCE ANIMATION (JS + motion-ok only) */
  .brain-js .node,
  .brain-js .edge {
    opacity: 0;
  }
  .brain-js .node.is-dimmed {
    opacity: 0.28;
  }
  .brain-js.is-loaded .edge {
    opacity: 0.28;
    transition: opacity 0.6s ease 0.7s;
  }
  .brain-js.is-loaded .node--center {
    opacity: 1;
    transition: opacity 0.5s ease 0s, transform 0.5s ease 0s;
  }
  .brain-js.is-loaded .node--core {
    opacity: 1;
    transition: opacity 0.5s ease 0.25s;
  }
  .brain-js.is-loaded .node--secondary,
  .brain-js.is-loaded .node--project {
    opacity: 1;
    transition: opacity 0.5s ease 0.5s;
  }

  /* IDLE DRIFT (motion-ok only, decorative, anchor point unaffected) */
  @media (prefers-reduced-motion: no-preference) {
    .node--center .node-shape {
      animation: drift-a 9s ease-in-out infinite;
    }
    .node--core:nth-of-type(3n) .node-shape {
      animation: drift-a 7s ease-in-out infinite;
    }
    .node--core:nth-of-type(3n + 1) .node-shape {
      animation: drift-b 8s ease-in-out infinite;
    }
    .node--core:nth-of-type(3n + 2) .node-shape {
      animation: drift-a 10s ease-in-out infinite;
    }
    .node--secondary:nth-of-type(2n) .node-shape,
    .node--project:nth-of-type(2n) .node-shape {
      animation: drift-b 11s ease-in-out infinite;
    }
    .node--secondary:nth-of-type(2n + 1) .node-shape,
    .node--project:nth-of-type(2n + 1) .node-shape {
      animation: drift-a 12s ease-in-out infinite;
    }
  }

  @keyframes drift-a {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(2px, -3px) rotate(0deg); }
  }
  .node--project .node-shape {
    animation-name: drift-project !important;
  }
  @keyframes drift-project {
    0%, 100% { transform: rotate(45deg) translate(0, 0); }
    50% { transform: rotate(45deg) translate(-2px, 2px); }
  }
  @keyframes drift-b {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-3px, 2px); }
  }

  /* PANEL */
  .brain-panel {
    border: 3px solid var(--ink);
    background: var(--paper);
    padding: clamp(24px, 3vw, 32px);
    min-height: 190px;
    display: flex;
    align-items: center;
  }
  .brain-panel-empty {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .brain-panel-empty .mono {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }
  .brain-panel-empty p {
    font-size: 15px;
    color: var(--navy);
    max-width: 50ch;
  }
  .brain-panel-content {
    width: 100%;
  }
  .brain-panel-tag {
    display: block;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mustard-deep);
    margin-bottom: 8px;
  }
  .brain-panel-content h2 {
    font-size: clamp(22px, 3vw, 30px);
