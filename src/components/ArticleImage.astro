---
// Coverfoto voor een artikelkaart. Toont de geoptimaliseerde afbeelding als
// die er is (1200x630, breedte/hoogte gezet tegen layout shift), anders een
// vlakke placeholder in de site-stijl — nooit een kapotte afbeelding.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image?: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
}

const { image, alt, sizes, class: className } = Astro.props;
---

<div class:list={["article-image", className]}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[400, 800, 1200]}
        sizes={sizes}
        width={1200}
        height={630}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="article-image-placeholder" role="img" aria-label={alt}>
        <span class="placeholder-mark mono">mh<span class="placeholder-dot">.</span></span>
      </span>
    )
  }
</div>

<style>
  .article-image {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1200 / 630;
    overflow: hidden;
    background: var(--paper);
    border: 1px solid var(--ink);
  }
  .article-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: var(--paper);
    background-image: repeating-linear-gradient(
      45deg,
      var(--line),
      var(--line) 1px,
      transparent 1px,
      transparent 14px
    );
  }
  .placeholder-mark {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    opacity: 0.35;
  }
  .placeholder-dot {
    color: var(--mustard);
    opacity: 1;
  }
</style>
