---
// "Uit de praktijk" op de homepage: één grote uitgelichte kaart, een rij
// van drie recente kaarten, en een link naar het volledige overzicht.
// Gedeeld door de NL- en EN-homepage; enkel de labels verschillen.
import ArticleImage from "./ArticleImage.astro";

interface ShowcaseArticle {
  href: string;
  title: string;
  excerpt: string;
  date: string;
  dateLabel: string;
  image?: import("astro").ImageMetadata;
  imageAlt?: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  headingEm: string;
  featured: ShowcaseArticle;
  featuredLabel: string;
  recent: ShowcaseArticle[];
  allArticlesHref: string;
  allArticlesLabel: string;
}

const {
  eyebrow,
  heading,
  headingEm,
  featured,
  featuredLabel,
  recent,
  allArticlesHref,
  allArticlesLabel,
} = Astro.props;
---

<section class="articles wrap" aria-labelledby="articles-title">
  <div class="articles-head">
    <span class="label">{eyebrow}</span>
    <h2 id="articles-title" class="articles-title">{heading} <em>{headingEm}</em></h2>
  </div>

  <a href={featured.href} class="featured-card">
    <ArticleImage image={featured.image} alt={featured.imageAlt ?? featured.title} sizes="(max-width: 780px) 100vw, 640px" class="featured-image" />
    <div class="featured-body">
      <span class="featured-badge mono">{featuredLabel}</span>
      <time class="featured-date mono" datetime={featured.date}>{featured.dateLabel}</time>
      <h3>{featured.title}</h3>
      <p>{featured.excerpt}</p>
      <span class="featured-arrow mono" aria-hidden="true">→</span>
    </div>
  </a>

  <ul class="recent-list">
    {
      recent.map((a) => (
        <li>
          <a href={a.href} class="recent-card">
            <ArticleImage image={a.image} alt={a.imageAlt ?? a.title} sizes="(max-width: 780px) 100vw, 33vw" class="recent-image" />
            <div class="recent-body">
              <time class="recent-date mono" datetime={a.date}>{a.dateLabel}</time>
              <h3>{a.title}</h3>
              <p class="recent-excerpt">{a.excerpt}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="articles-cta">
    <a class="btn" href={allArticlesHref}>{allArticlesLabel}</a>
  </div>
</section>

<style>
  .articles {
    padding-block: clamp(40px, 6vw, 64px);
    border-bottom: 1px solid var(--ink);
  }
  .articles-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: clamp(24px, 4vw, 36px);
  }
  .articles-title {
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 800;
    line-height: 1.05;
  }

  /* ---------- Uitgelichte kaart ---------- */
  .featured-card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: center;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: clamp(16px, 2vw, 24px);
    margin-bottom: clamp(28px, 4vw, 40px);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .featured-card:hover {
    transform: translateY(-2px);
    background: var(--cream);
  }
  .featured-card :global(.featured-image) {
    border-color: var(--ink);
  }
  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .featured-badge {
    display: inline-block;
    width: fit-content;
    padding: 3px 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--mustard);
    color: var(--paper);
  }
  .featured-date {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--rust);
  }
  .featured-body h3 {
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    line-height: 1.15;
    margin-top: 4px;
  }
  .featured-body p {
    font-size: 15px;
    line-height: 1.6;
    opacity: 0.85;
    max-width: 60ch;
  }
  .featured-arrow {
    margin-top: 6px;
    font-size: 16px;
    color: var(--navy);
    transition: color 0.15s ease;
  }
  .featured-card:hover .featured-arrow {
    color: var(--rust);
  }
  @media (max-width: 780px) {
    .featured-card {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Rij van drie recente kaarten ---------- */
  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 2.4vw, 28px);
  }
  .recent-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid var(--ink);
    background: var(--paper);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .recent-card:hover {
    transform: translateY(-2px);
    background: var(--cream);
  }
  .recent-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
  }
  .recent-date {
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--rust);
  }
  .recent-body h3 {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
  }
  .recent-excerpt {
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.8;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.2s ease, opacity 0.2s ease, margin-top 0.2s ease;
  }
  /* Intro alleen tonen bij hover/focus, en enkel op toestellen met een muis
     (desktop) — op touch-only blijft de kaart compact. */
  @media (hover: hover) and (pointer: fine) {
    .recent-card:hover .recent-excerpt,
    .recent-card:focus-visible .recent-excerpt {
      max-height: 6em;
      opacity: 0.8;
      margin-top: 2px;
    }
  }

  @media (max-width: 780px) {
    .recent-list {
      grid-template-columns: 1fr;
    }
  }

  .articles-cta {
    display: flex;
    justify-content: center;
    margin-top: clamp(28px, 4vw, 40px);
  }
</style>
