---
// Commandobalk: opent met Cmd/Ctrl+K of via het zoekicoon (CommandPaletteTrigger).
// Eén instance per pagina, gerenderd vanuit BaseLayout. De zoekindex wordt
// tijdens de build gegenereerd (search-index.json / en/search-index.json)
// en éénmalig client-side opgehaald — filteren gebeurt daarna volledig
// lokaal, zonder request per toetsaanslag.
import { useTranslations, type Language } from "../i18n/ui";

interface Props {
  locale?: Language;
}
const { locale = "nl" } = Astro.props;
const indexUrl = locale === "en" ? "/en/search-index.json" : "/search-index.json";
const t = useTranslations(locale).search;
---

<div class="cmdk-overlay" id="cmdk-overlay" hidden>
  <div class="cmdk-backdrop" data-cmdk-close></div>
  <div
    class="cmdk-panel"
    role="dialog"
    aria-modal="true"
    aria-label={t.dialogLabel}
    id="cmdk-panel"
  >
    <div class="cmdk-input-row">
      <svg class="cmdk-icon" viewBox="0 0 18 18" width="16" height="16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.6" />
        <line x1="12.2" y1="12.2" x2="16.5" y2="16.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <input
        type="text"
        id="cmdk-input"
        class="cmdk-input"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
        aria-haspopup="listbox"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder={t.placeholder}
      />
      <button type="button" class="cmdk-close" data-cmdk-close aria-label={t.close}>
        Esc
      </button>
    </div>

    <ul class="cmdk-list" id="cmdk-list" role="listbox" aria-label={t.dialogLabel}></ul>
    <p class="cmdk-empty" id="cmdk-empty" hidden>{t.noResults}</p>

    <div class="cmdk-footer mono">
      <span><kbd>↑</kbd><kbd>↓</kbd> {t.hintNavigate}</span>
      <span><kbd>↵</kbd> {t.hintSelect}</span>
      <span><kbd>Esc</kbd> {t.hintClose}</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ indexUrl, t }}>
  const overlay = document.getElementById("cmdk-overlay");
  const panel = document.getElementById("cmdk-panel");
  const input = document.getElementById("cmdk-input");
  const list = document.getElementById("cmdk-list");
  const emptyMsg = document.getElementById("cmdk-empty");
  const closeBtn = panel?.querySelector("[data-cmdk-close]");

  if (overlay && panel && input && list && emptyMsg && closeBtn) {
    let cachedIndex = null;
    let fetchPromise = null;
    let lastFocused = null;
    let activeIndex = -1;
    let optionEls = [];

    function normalize(value) {
      return value
        .normalize("NFD")
        .replace(/[̀-ͯ]/g, "")
        .toLowerCase();
    }

    function loadIndex() {
      if (cachedIndex) return Promise.resolve(cachedIndex);
      if (!fetchPromise) {
        fetchPromise = fetch(indexUrl)
          .then((res) => res.json())
          .then((data) => {
            cachedIndex = data;
            return data;
          })
          .catch(() => {
            cachedIndex = { sections: [], articles: [] };
            return cachedIndex;
          });
      }
      return fetchPromise;
    }

    // Prefetch tijdens idle tijd zodat het eerste openen van de balk geen
    // zichtbare laadvertraging heeft — nog steeds maar één request in totaal.
    const schedule = window.requestIdleCallback || ((fn) => setTimeout(fn, 300));
    schedule(() => loadIndex());

    function computeGroups(query) {
      if (!cachedIndex) return [];
      const q = normalize(query.trim());

      if (!q) {
        const groups = [];
        if (cachedIndex.sections.length) {
          groups.push({
            label: t.sectionsGroup,
            entries: cachedIndex.sections.map((s) => ({
              title: s.title,
              subtitle: s.subtitle,
              href: s.href,
            })),
          });
        }
        if (cachedIndex.articles.length) {
          groups.push({
            label: t.recentGroup,
            entries: cachedIndex.articles.slice(0, 3).map((a) => ({
              title: a.title,
              subtitle: a.excerpt,
              href: a.href,
            })),
          });
        }
        return groups;
      }

      const sections = cachedIndex.sections
        .filter((s) => normalize(s.title).includes(q) || normalize(s.subtitle).includes(q))
        .map((s) => ({ title: s.title, subtitle: s.subtitle, href: s.href }));

      const articles = cachedIndex.articles
        .filter((a) => normalize(a.title).includes(q) || normalize(a.excerpt).includes(q))
        .map((a) => ({ title: a.title, subtitle: a.excerpt, href: a.href }));

      const groups = [];
      if (sections.length) groups.push({ label: t.sectionsGroup, entries: sections });
      if (articles.length) groups.push({ label: t.articlesGroup, entries: articles });
      return groups;
    }

    function render(groups) {
      list.innerHTML = "";
      optionEls = [];
      activeIndex = -1;

      const hasResults = groups.some((g) => g.entries.length > 0);
      emptyMsg.hidden = hasResults;

      let optionIndex = 0;
      for (const group of groups) {
        const heading = document.createElement("li");
        heading.className = "cmdk-group-label label";
        heading.setAttribute("role", "presentation");
        heading.textContent = group.label;
        list.appendChild(heading);

        for (const entry of group.entries) {
          const li = document.createElement("li");
          li.className = "cmdk-option";
          li.id = `cmdk-option-${optionIndex}`;
          li.setAttribute("role", "option");
          li.setAttribute("aria-selected", "false");
          li.dataset.href = entry.href;

          const title = document.createElement("span");
          title.className = "cmdk-option-title";
          title.textContent = entry.title;
          li.appendChild(title);

          if (entry.subtitle) {
            const subtitle = document.createElement("span");
            subtitle.className = "cmdk-option-subtitle";
            subtitle.textContent = entry.subtitle;
            li.appendChild(subtitle);
          }

          li.addEventListener("mouseenter", () => setActive(optionEls.indexOf(li)));
          li.addEventListener("click", () => navigateTo(entry.href));

          list.appendChild(li);
          optionEls.push(li);
          optionIndex += 1;
        }
      }

      if (optionEls.length > 0) setActive(0);
    }

    function setActive(index) {
      if (optionEls.length === 0) {
        activeIndex = -1;
        input.removeAttribute("aria-activedescendant");
        return;
      }
      const next = (index + optionEls.length) % optionEls.length;
      if (activeIndex >= 0 && optionEls[activeIndex]) {
        optionEls[activeIndex].setAttribute("aria-selected", "false");
      }
      activeIndex = next;
      const el = optionEls[activeIndex];
      el.setAttribute("aria-selected", "true");
      input.setAttribute("aria-activedescendant", el.id);
      el.scrollIntoView({ block: "nearest" });
    }

    function navigateTo(href) {
      close();
      window.location.href = href;
    }

    async function open(trigger) {
      lastFocused = trigger instanceof HTMLElement ? trigger : document.activeElement;
      overlay.hidden = false;
      document.body.classList.add("cmdk-lock-scroll");
      input.value = "";
      input.focus();
      await loadIndex();
      render(computeGroups(""));
    }

    function close() {
      if (overlay.hidden) return;
      overlay.hidden = true;
      document.body.classList.remove("cmdk-lock-scroll");
      if (lastFocused && document.contains(lastFocused)) {
        lastFocused.focus();
      }
      lastFocused = null;
    }

    input.addEventListener("input", () => {
      render(computeGroups(input.value));
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        setActive(activeIndex + 1);
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        setActive(activeIndex - 1);
      } else if (event.key === "Enter") {
        event.preventDefault();
        const el = optionEls[activeIndex];
        if (el?.dataset.href) navigateTo(el.dataset.href);
      } else if (event.key === "Escape") {
        event.preventDefault();
        close();
      } else if (event.key === "Tab") {
        // Focus-trap tussen input en sluitknop — de lijst zelf neemt geen
        // tabvolgorde in (navigatie gaat via pijltjestoetsen).
        if (!event.shiftKey) {
          event.preventDefault();
          closeBtn.focus();
        }
      }
    });

    closeBtn.addEventListener("keydown", (event) => {
      if (event.key === "Tab" && !event.shiftKey) {
        event.preventDefault();
        input.focus();
      } else if (event.key === "Escape") {
        event.preventDefault();
        close();
      }
    });
    closeBtn.addEventListener("click", close);

    overlay.querySelectorAll("[data-cmdk-close]").forEach((el) => {
      el.addEventListener("click", (event) => {
        if (event.target === el) close();
      });
    });

    document.addEventListener("click", (event) => {
      const opener = event.target instanceof Element ? event.target.closest("[data-cmdk-open]") : null;
      if (opener) {
        event.preventDefault();
        open(opener);
      }
    });

    document.addEventListener("keydown", (event) => {
      const isShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
      if (isShortcut) {
        event.preventDefault();
        if (overlay.hidden) open();
        else close();
      } else if (event.key === "Escape" && !overlay.hidden) {
        close();
      }
    });
  }
</script>

<style>
  .cmdk-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    justify-content: center;
    padding: min(14vh, 120px) 16px 16px;
  }
  /* [hidden] heeft dezelfde specificiteit als .cmdk-overlay zelf; zonder deze
     regel wint de author-stylesheet en blijft display:flex staan, waardoor de
     "gesloten" overlay onzichtbaar toch klikken blijft onderscheppen. */
  .cmdk-overlay[hidden] {
    display: none;
  }

  .cmdk-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 55%, transparent);
  }

  .cmdk-panel {
    position: relative;
    width: 100%;
    max-width: 620px;
    max-height: min(70vh, 560px);
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 2px solid var(--ink);
    color: var(--ink);
  }

  .cmdk-input-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }

  .cmdk-icon {
    flex-shrink: 0;
    color: var(--navy);
    opacity: 0.7;
  }

  .cmdk-input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 17px;
  }
  .cmdk-input::placeholder {
    color: var(--ink);
    opacity: 0.45;
  }

  .cmdk-close {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--navy);
    background: transparent;
    border: 1px solid var(--line);
    padding: 5px 9px;
  }
  .cmdk-close:hover,
  .cmdk-close:focus-visible {
    border-color: var(--navy);
  }
  .cmdk-close:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 2px;
  }

  .cmdk-list {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
    flex: 1;
  }

  .cmdk-group-label {
    padding: 10px 10px 6px;
  }

  .cmdk-option {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    cursor: pointer;
    border-left: 3px solid transparent;
  }
  .cmdk-option[aria-selected="true"] {
    background: var(--cream);
    border-left-color: var(--mustard);
  }
  .cmdk-option-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--navy);
  }
  .cmdk-option-subtitle {
    font-size: 13px;
    line-height: 1.4;
    opacity: 0.7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmdk-empty {
    padding: 28px 18px;
    text-align: center;
    font-size: 14px;
    opacity: 0.65;
  }

  .cmdk-footer {
    display: flex;
    gap: 18px;
    padding: 10px 18px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    opacity: 0.65;
    flex-shrink: 0;
  }
  .cmdk-footer kbd {
    display: inline-block;
    border: 1px solid var(--line);
    padding: 1px 5px;
    margin-right: 3px;
    font-family: var(--font-mono);
  }

  @media (max-width: 560px) {
    .cmdk-footer {
      display: none;
    }
    .cmdk-panel {
      max-height: min(78vh, 560px);
    }
  }
</style>
