---
import { Image } from "astro:assets";
import duneDuo from "../assets/gallery/dune-duo.jpg";
import catBowl from "../assets/gallery/cat-bowl.jpg";
import coastalCliff from "../assets/gallery/coastal-cliff.jpg";
import catStairsBw from "../assets/gallery/cat-stairs-bw.jpg";
import catDoorway from "../assets/gallery/cat-doorway.jpg";
---

<div class="gallery">
  <div class="g-item g-dune">
    <Image
      src={duneDuo}
      alt="Twee silhouetten op een duin bij zonsondergang, met de zee op de achtergrond"
      loading="lazy"
      widths={[480, 800, 1200]}
      sizes="(max-width: 780px) 90vw, 45vw"
    />
  </div>
  <div class="g-item g-bowl">
    <Image
      src={catBowl}
      alt="Rode kat vlak bij een kom"
      loading="lazy"
      widths={[320, 560, 800]}
      sizes="(max-width: 780px) 45vw, 25vw"
    />
  </div>
  <div class="g-item g-bw">
    <Image
      src={catStairsBw}
      alt="Zwart-witfoto van een kat die tussen de spijlen van een trapleuning gluurt"
      loading="lazy"
      widths={[320, 560, 800]}
      sizes="(max-width: 780px) 45vw, 20vw"
    />
  </div>
  <div class="g-item g-cliff">
    <Image
      src={coastalCliff}
      alt="Uitzicht over zee en krijtrotsen aan de kust"
      loading="lazy"
      widths={[480, 800, 1200]}
      sizes="(max-width: 780px) 90vw, 45vw"
    />
  </div>
  <div class="g-item g-doorway">
    <Image
      src={catDoorway}
      alt="Rode kat met gps-halsband in een deuropening"
      loading="lazy"
      widths={[320, 560, 800]}
      sizes="(max-width: 780px) 90vw, 30vw"
    />
  </div>
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 80px;
    gap: 14px;
  }

  .g-item {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    background: var(--paper);
    border: 1px solid var(--ink);
  }

  .g-item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .g-dune {
    grid-column: 1 / span 4;
    grid-row: 1 / span 3;
  }
  .g-dune :global(img) {
    object-position: center 70%;
  }

  .g-bowl {
    grid-column: 5 / span 2;
    grid-row: 1 / span 4;
  }

  .g-bw {
    grid-column: 1 / span 2;
    grid-row: 4 / span 4;
  }

  .g-cliff {
    grid-column: 3 / span 4;
    grid-row: 4 / span 4;
  }

  .g-doorway {
    grid-column: 2 / span 3;
    grid-row: 8 / span 4;
  }

  @media (max-width: 780px) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: auto;
    }
    .g-item {
      grid-column: auto !important;
      grid-row: auto !important;
    }
    .g-dune,
    .g-cliff {
      grid-column: 1 / -1 !important;
      aspect-ratio: 4 / 3;
    }
    .g-bowl {
      aspect-ratio: 4 / 5;
    }
    .g-bw,
    .g-doorway {
      aspect-ratio: 3 / 4;
    }
  }

  @media (max-width: 480px) {
    .gallery {
      grid-template-columns: 1fr;
    }
    .g-item {
      grid-column: 1 / -1 !important;
    }
  }
</style>
