---
interface Milestone {
  age: string;
  title: string;
  body: string;
}

const milestones: Milestone[] = [
  {
    age: "14 jaar",
    title: "Eerste verkoop",
    body: "Tupperware wordt de eerste keer dat ik geld verdien met verkopen. Het begin van een fascinatie voor vraag, aanbod en timing.",
  },
  {
    age: "Sneakers-jaren",
    title: "Restocks en het omslaan van een markt",
    body: "Handel in sneakers, tot het faillissement van Restocks. Een harde les in hoe snel een markt — en het vertrouwen erin — kan kantelen.",
  },
  {
    age: "Afgerond",
    title: "VintieBulk",
    body: "B2B-groothandel in gecureerde Ralph Lauren-partijen, door mij opgezet en opgebouwd. Het bedrijf bestaat intussen onder een andere naam verder, zonder mij.",
  },
  {
    age: "Actief",
    title: "Studio Maud",
    body: "Data-gedreven reselling op Vinted: van sourcing tot logistiek, gebouwd op inmiddels meer dan 2.500 transacties.",
  },
  {
    age: "Vandaag",
    title: "Criminologie & ondernemerschap",
    body: "Laatstejaars Criminologische Wetenschappen aan de UGent, naast het runnen van Studio Maud. Twee werelden, één blik op patronen en systemen.",
  },
];
---

<div class="timeline-wrap">
  <p class="timeline-hint mono">Scroll voor het volledige traject →</p>
  <div class="timeline-scroll">
    <div class="timeline-track">
      <div class="timeline-line" aria-hidden="true"></div>
      {
        milestones.map((m) => (
          <div class="milestone">
            <span class="milestone-dot" aria-hidden="true" />
            <span class="milestone-year mono">{m.age}</span>
            <h3>{m.title}</h3>
            <p>{m.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .timeline-hint {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--navy);
    opacity: 0.75;
    margin-bottom: 18px;
  }

  .timeline-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 16px;
    scroll-snap-type: x proximity;
    scrollbar-color: var(--navy) var(--cream);
    scrollbar-width: thin;
  }
  .timeline-scroll::-webkit-scrollbar {
    height: 8px;
  }
  .timeline-scroll::-webkit-scrollbar-track {
    background: var(--cream);
  }
  .timeline-scroll::-webkit-scrollbar-thumb {
    background: var(--navy);
  }

  .timeline-track {
    position: relative;
    display: flex;
    width: max-content;
    padding: 40px 12px 4px;
  }

  .timeline-line {
    position: absolute;
    top: 34px;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--navy);
  }

  .milestone {
    flex: 0 0 auto;
    width: 280px;
    position: relative;
    padding: 0 26px;
    scroll-snap-align: start;
  }

  .milestone-dot {
    position: absolute;
    top: 26px;
    left: 26px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--mustard);
    border: 3px solid var(--ink);
    z-index: 1;
  }

  .milestone-year {
    display: block;
    margin-top: 56px;
    margin-bottom: 12px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }

  .milestone h3 {
    font-size: clamp(19px, 2.4vw, 23px);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .milestone p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .milestone {
      width: 240px;
    }
  }
</style>
