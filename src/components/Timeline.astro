---
interface Milestone {
  age: string;
  title: string;
  body: string | string[];
}

interface Props {
  locale?: "nl" | "en";
}
const { locale = "nl" } = Astro.props;

const milestonesByLocale: Record<"nl" | "en", Milestone[]> = {
  nl: [
    {
      age: "14 jaar",
      title: "Eerste verkoop",
      body: "Mijn eerste verkoop was een plastic Tupperware potje. Ingekocht voor twee euro, doorverkocht voor vijf. Drie euro winst en het besef dat waarde niet vastzit in wat iets is, maar in wie het zoekt en waar het aangeboden wordt.",
    },
    {
      age: "Sneakers-jaren",
      title: "Restocks en het omslaan van een markt",
      body: "Daarna kwamen sneakers. Wekker om 8u50, raffle om 9u, hopen dat je geselecteerd werd. Een paar kostte 120 tot 220 euro en de marge was flinterdun. En toen ging Restocks failliet.",
    },
    {
      age: "Afgerond",
      title: "VintieBulk",
      body: "B2B-groothandel in gecureerde Ralph Lauren-partijen, door mij opgezet en opgebouwd.",
    },
    {
      age: "Actief",
      title: "Studio Maud",
      body: "Data-gedreven reselling op Vinted: van sourcing tot logistiek, gebouwd op inmiddels meer dan 2.500 transacties.",
    },
    {
      age: "Vandaag",
      title: "Criminologie & ondernemerschap",
      body: "Laatstejaars Criminologische Wetenschappen aan de UGent, naast het runnen van Studio Maud. Twee werelden, één blik op patronen en systemen.",
    },
  ],
  en: [
    {
      age: "Age 14",
      title: "First sale",
      body: "My first sale was a plastic Tupperware container. Bought for two euros, resold for five. Three euros profit, and the realisation that value doesn't sit in what a thing is, but in who's looking for it and where it's offered.",
    },
    {
      age: "The sneaker years",
      title: "Restocks, and a market flipping overnight",
      body: "Then came sneakers. Alarm at 8:50am, raffle at 9am, hoping you got selected. A pair cost 120 to 220 euros and the margin was razor-thin. Then Restocks went bankrupt.",
    },
    {
      age: "Wound down",
      title: "VintieBulk",
      body: "A B2B wholesale operation for curated Ralph Lauren lots, set up and built by me.",
    },
    {
      age: "Active",
      title: "Studio Maud",
      body: "Data-driven reselling on Vinted: from sourcing to logistics, built on more than 2,500 transactions by now.",
    },
    {
      age: "Today",
      title: "Criminology & entrepreneurship",
      body: "Final-year Criminological Sciences student at Ghent University, alongside running Studio Maud. Two worlds, one eye for patterns and systems.",
    },
  ],
};

const milestones = milestonesByLocale[locale];
const hintByLocale = { nl: "Scroll voor het volledige traject →", en: "Scroll for the full journey →" };
---

<div class="timeline-wrap">
  <p class="timeline-hint mono">{hintByLocale[locale]}</p>
  <div class="timeline-scroll">
    <div class="timeline-track">
      <div class="timeline-line" aria-hidden="true"></div>
      {
        milestones.map((m) => (
          <div class="milestone">
            <span class="milestone-dot" aria-hidden="true" />
            <span class="milestone-year mono">{m.age}</span>
            <h3>{m.title}</h3>
            {Array.isArray(m.body) ? (
              m.body.map((para) => <p>{para}</p>)
            ) : (
              <p>{m.body}</p>
            )}
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .timeline-hint {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--navy);
    opacity: 0.75;
    margin-bottom: 18px;
  }

  .timeline-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 16px;
    scroll-snap-type: x proximity;
    scrollbar-color: var(--navy) var(--cream);
    scrollbar-width: thin;
  }
  .timeline-scroll::-webkit-scrollbar {
    height: 8px;
  }
  .timeline-scroll::-webkit-scrollbar-track {
    background: var(--cream);
  }
  .timeline-scroll::-webkit-scrollbar-thumb {
    background: var(--navy);
  }

  .timeline-track {
    position: relative;
    display: flex;
    width: max-content;
    padding: 40px 12px 4px;
  }

  .timeline-line {
    position: absolute;
    top: 34px;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--navy);
  }

  .milestone {
    flex: 0 0 auto;
    width: 280px;
    position: relative;
    padding: 0 26px;
    scroll-snap-align: start;
  }

  .milestone-dot {
    position: absolute;
    top: 26px;
    left: 26px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--mustard);
    border: 1px solid var(--ink);
    z-index: 1;
  }

  .milestone-year {
    display: block;
    margin-top: 56px;
    margin-bottom: 12px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }

  .milestone h3 {
    font-size: clamp(19px, 2.4vw, 23px);
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .milestone p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
  }
  .milestone p + p {
    margin-top: 10px;
  }

  @media (max-width: 640px) {
    .milestone {
      width: 240px;
    }
  }
</style>
