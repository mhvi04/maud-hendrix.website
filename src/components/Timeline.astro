---
interface Milestone {
  age: string;
  title: string;
  body: string | string[];
}

const milestones: Milestone[] = [
  {
    age: "14 jaar",
    title: "Eerste verkoop",
    body: [
      "Tupperware wordt de eerste keer dat ik geld verdien met verkopen. Het begin van een fascinatie voor vraag, aanbod en timing.",
      "Mijn allereerste verkoop was een plastic Tupperware potje. Ik was veertien. Ingekocht voor twee euro, doorverkocht voor vijf. Drie euro winst, en het gevoel dat ik iets begreep wat de meeste mensen om me heen niet zagen: dat de waarde van een ding niet vastzit in wat het is, maar in wie het zoekt en waar het aangeboden wordt. Dat klinkt achteraf veel strategischer dan het was.",
    ],
  },
  {
    age: "Sneakers-jaren",
    title: "Restocks en het omslaan van een markt",
    body: [
      "Na ontelbare verkochte vintage Tupperware-potjes ging ik sneakers doen. Exclusieve Nikes, Jordans, en zo verder. Wekker om 8u50, meedoen aan online raffles om 9u, hopen dat je geselecteerd werd. Het paar inkopen voor 120 tot 220 euro en dan proberen het met een beetje winst door te verkopen. Op papier leek dat slim. In de praktijk waren de marges flinterdun en het risico veel groter dan ik toen besefte.",
      "En toen ging Restocks failliet.",
    ],
  },
  {
    age: "Afgerond",
    title: "VintieBulk",
    body: "B2B-groothandel in gecureerde Ralph Lauren-partijen, door mij opgezet en opgebouwd.",
  },
  {
    age: "Actief",
    title: "Studio Maud",
    body: "Data-gedreven reselling op Vinted: van sourcing tot logistiek, gebouwd op inmiddels meer dan 2.500 transacties.",
  },
  {
    age: "Vandaag",
    title: "Criminologie & ondernemerschap",
    body: "Laatstejaars Criminologische Wetenschappen aan de UGent, naast het runnen van Studio Maud. Twee werelden, één blik op patronen en systemen.",
  },
];
---

<div class="timeline-wrap">
  <p class="timeline-hint mono">Scroll → en tap een periode open voor meer detail</p>
  <div class="timeline-scroll">
    <div class="timeline-track">
      <div class="timeline-line" aria-hidden="true"></div>
      {
        milestones.map((m) => (
          <div class="milestone">
            <span class="milestone-dot" aria-hidden="true" />
            <details class="milestone-details">
              <summary class="milestone-summary">
                <span class="milestone-year mono">{m.age}</span>
                <h3>{m.title}</h3>
                <span class="milestone-toggle" aria-hidden="true" />
              </summary>
              <div class="milestone-body">
                {Array.isArray(m.body) ? (
                  m.body.map((para) => <p>{para}</p>)
                ) : (
                  <p>{m.body}</p>
                )}
              </div>
            </details>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  function prefersReducedMotion() {
    return (
      document.documentElement.classList.contains("reduce-motion") ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    );
  }

  document
    .querySelectorAll<HTMLDetailsElement>(".milestone-details")
    .forEach((details) => {
      details.addEventListener("toggle", () => {
        if (!details.open || prefersReducedMotion()) return;
        const body = details.querySelector<HTMLElement>(".milestone-body");
        body?.animate(
          [
            { opacity: 0, transform: "translateY(-6px)" },
            { opacity: 1, transform: "translateY(0)" },
          ],
          { duration: 220, easing: "ease-out" }
        );
      });
    });
</script>

<style>
  .timeline-hint {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--navy);
    opacity: 0.75;
    margin-bottom: 18px;
  }

  .timeline-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 16px;
    scroll-snap-type: x proximity;
    scrollbar-color: var(--navy) var(--cream);
    scrollbar-width: thin;
  }
  .timeline-scroll::-webkit-scrollbar {
    height: 8px;
  }
  .timeline-scroll::-webkit-scrollbar-track {
    background: var(--cream);
  }
  .timeline-scroll::-webkit-scrollbar-thumb {
    background: var(--navy);
  }

  .timeline-track {
    position: relative;
    display: flex;
    width: max-content;
    padding: 40px 12px 4px;
  }

  .timeline-line {
    position: absolute;
    top: 34px;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--navy);
  }

  .milestone {
    flex: 0 0 auto;
    width: 280px;
    position: relative;
    padding: 0 26px;
    scroll-snap-align: start;
  }

  .milestone-dot {
    position: absolute;
    top: 26px;
    left: 26px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--mustard);
    border: 3px solid var(--ink);
    z-index: 1;
  }

  .milestone-details {
    margin-top: 56px;
  }

  .milestone-summary {
    display: block;
    cursor: pointer;
    list-style: none;
  }
  .milestone-summary::-webkit-details-marker {
    display: none;
  }
  .milestone-summary::marker {
    content: "";
  }
  .milestone-summary:focus-visible {
    outline: 2px solid var(--navy);
    outline-offset: 4px;
  }

  .milestone-year {
    display: block;
    margin-bottom: 12px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mustard-deep);
  }

  .milestone h3 {
    display: inline;
    font-size: clamp(19px, 2.4vw, 23px);
    font-weight: 600;
    line-height: 1.2;
  }

  .milestone-toggle {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 8px;
    vertical-align: middle;
    border-right: 2px solid var(--navy);
    border-bottom: 2px solid var(--navy);
    transform: translateY(-3px) rotate(45deg);
    transition: transform 0.2s ease;
  }
  .milestone-details[open] .milestone-toggle {
    transform: translateY(2px) rotate(-135deg);
  }

  .milestone-body {
    padding-top: 12px;
  }

  .milestone p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink);
  }
  .milestone p + p {
    margin-top: 10px;
  }

  @media (max-width: 640px) {
    .milestone {
      width: 240px;
    }
  }
</style>
