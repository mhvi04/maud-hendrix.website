---
// LanguageSwitch.astro
// Tekstswitch "NL / EN". De actieve taal is gewone tekst in de inktkleur, de
// andere taal is een link op 50% opacity naar dezelfde pagina in die taal.
// Lettertype en grootte worden geërfd van de omgeving, zodat hij in de
// header exact meeloopt met "Menu". nlPath/enPath zijn locale-interne paden
// (zonder /en-prefix), omdat getRelativeLocaleUrl die prefix zelf toevoegt.
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, type Language } from "../i18n/ui";

interface Props {
  locale: Language;
  nlPath: string;
  enPath: string;
}

const { locale, nlPath, enPath } = Astro.props;
const t = useTranslations(locale).nav;
const nlHref = getRelativeLocaleUrl("nl", nlPath);
const enHref = getRelativeLocaleUrl("en", enPath);
const langs = [
  { code: "nl" as const, label: "NL", href: nlHref },
  { code: "en" as const, label: "EN", href: enHref },
];
---

<span class="lang-switch">
  {langs.map((l, i) => (
    <Fragment>
      {i > 0 && <span class="sep" aria-hidden="true">/</span>}
      {l.code === locale ? (
        <span class="lang is-active" lang={l.code} aria-current="true">{l.label}</span>
      ) : (
        <a class="lang" href={l.href} hreflang={l.code} lang={l.code} aria-label={t.switchLanguageLabel}>{l.label}</a>
      )}
    </Fragment>
  ))}
</span>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font: inherit;
    color: var(--ink);
    white-space: nowrap;
  }
  .lang {
    color: inherit;
    text-decoration: none;
    /* Ruim tikvlak, zonder de layout groter te maken. */
    padding-block: 12px;
  }
  a.lang,
  .sep {
    opacity: 0.5;
  }
  a.lang {
    transition: opacity 0.15s ease;
  }
  a.lang:hover {
    opacity: 1;
  }
  a.lang:focus-visible {
    opacity: 1;
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
</style>
