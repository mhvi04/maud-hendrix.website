---
// LanguageNotice.astro
// Kleine, wegklikbare melding voor bezoekers met een niet-Nederlandse
// browsertaal: er bestaat een Engelse versie van deze pagina. Er wordt nooit
// automatisch doorgestuurd. Dat de melding weggeklikt is staat in
// localStorage; zonder localStorage blijft de melding gewoon werken.
// Standaard verborgen, het script toont hem pas na de taalcheck.
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  enPath: string;
}

const href = getRelativeLocaleUrl("en", Astro.props.enPath);
---

<aside class="lang-notice" id="lang-notice" lang="en" hidden aria-label="Language">
  <p>
    This page is also available in English.
    <a href={href} hreflang="en" data-lang-notice-go>Read the English version</a>
  </p>
  <button type="button" class="close" data-lang-notice-close aria-label="Dismiss">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" />
    </svg>
  </button>
</aside>

<script>
  const KEY = "lang-notice-dismissed";
  const el = document.getElementById("lang-notice");

  function dismissedBefore(): boolean {
    try {
      return localStorage.getItem(KEY) === "1";
    } catch {
      return false;
    }
  }
  function remember() {
    try {
      localStorage.setItem(KEY, "1");
    } catch {
      /* geen opslag beschikbaar: melding verdwijnt alleen voor deze pagina */
    }
  }
  function hide() {
    if (el) el.hidden = true;
  }

  if (el) {
    const langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language]).filter(Boolean);
    const primary = (langs[0] ?? "nl").toLowerCase();
    const isDutch = primary === "nl" || primary.startsWith("nl-");
    if (!isDutch && !dismissedBefore()) el.hidden = false;

    el.querySelector("[data-lang-notice-close]")?.addEventListener("click", () => {
      remember();
      hide();
    });
    el.querySelector("[data-lang-notice-go]")?.addEventListener("click", remember);
  }
</script>

<style>
  .lang-notice {
    position: fixed;
    left: clamp(12px, 3vw, 24px);
    bottom: clamp(12px, 3vw, 24px);
    z-index: 80;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: min(340px, calc(100vw - 24px));
    padding: 12px 8px 12px 16px;
    background: var(--cream);
    color: var(--ink);
    border: 1px solid var(--ink);
    font-size: 14px;
    line-height: 1.4;
  }
  .lang-notice[hidden] {
    display: none;
  }
  .lang-notice p {
    margin: 0;
  }
  .lang-notice a {
    display: inline-block;
    color: var(--ink);
    font-weight: 600;
    text-decoration-color: var(--rust);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-top: -6px;
    background: none;
    border: 0;
    padding: 0;
    color: var(--ink);
    cursor: pointer;
  }
  .lang-notice a:focus-visible,
  .close:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
