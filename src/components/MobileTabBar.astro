---
// MobileTabBar.astro
// Tabbalk onderaan voor smalle schermen (iPhone-webapp-weergave):
// Home, Pro, Privé en Artikelen binnen duimbereik. Op brede schermen
// verborgen, daar blijft de SiteHeader de navigatie.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const tabs = [
  { key: "home", href: "/", label: "Home", match: (p: string) => p === "/" },
  { key: "pro", href: "/professioneel", label: "Pro", match: (p: string) => p.startsWith("/professioneel") },
  { key: "prive", href: "/prive", label: "Privé", match: (p: string) => p.startsWith("/prive") },
  { key: "artikelen", href: "/artikelen", label: "Artikelen", match: (p: string) => p.startsWith("/artikelen") },
];
---

<nav class="tabbar" aria-label="Hoofdnavigatie">
  {tabs.map((tab) => {
    const on = tab.match(path);
    return (
      <a href={tab.href} class:list={["tab", { on }]} aria-current={on ? "page" : undefined}>
        <span class="ico">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {tab.key === "home" && (<><path d="M3 11l9-8 9 8" /><path d="M5 10v10h5v-6h4v6h5V10" /></>)}
            {tab.key === "pro" && (<><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M9 7V5a1 1 0 011-1h4a1 1 0 011 1v2" /><path d="M3 13h18" /></>)}
            {tab.key === "prive" && <path d="M12 20s-7-4.5-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.5-7 10-7 10z" />}
            {tab.key === "artikelen" && (<><path d="M5 4h14v16H5z" /><path d="M8.5 9h7M8.5 13h7M8.5 17h4" /></>)}
          </svg>
        </span>
        {tab.label}
      </a>
    );
  })}
</nav>

<style>
  .tabbar {
    display: none;
  }

  @media (max-width: 560px) {
    .tabbar {
      display: flex;
      position: fixed;
      inset: auto 0 0 0;
      z-index: 50;
      padding: 8px 8px calc(8px + env(safe-area-inset-bottom, 0px));
      background: var(--cream);
      border-top: 1px solid var(--line);
    }
    .tab {
      flex: 1;
      min-height: 56px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.02em;
      color: var(--ink);
      opacity: 0.72;
      text-decoration: none;
    }
    .tab.on {
      opacity: 1;
      font-weight: 500;
    }
    .ico {
      width: 48px;
      height: 28px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .tab.on .ico {
      background: var(--mustard);
      color: var(--navy-deep);
    }
  }
</style>
